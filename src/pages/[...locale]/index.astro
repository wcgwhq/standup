---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { copy, localePath, localeStaticPaths, siteNameFor } from '@/i18n';
import CodeBlock from '@/components/CodeBlock.astro';
import { siteName } from '../../../site.config.mjs';
import install from '@/data/install.json';
import report from '@/data/sample-report.json';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const ui = copy(locale);

// One lede per part of the day; SunDial.astro picks by the time on the dial.
const ledes = {
  morning: ui.ledeMorning,
  midmorning: ui.ledeMidmorning,
  afternoon: ui.ledeAfternoon,
  evening: ui.ledeEvening,
  night: ui.ledeNight,
};

const site = Astro.site!;
const llms = new URL('/llms.txt', site).href;
const agentPrompt = ui.agentPrompt.replace('{llms}', llms).replace('{command}', install.command);

// What the plugin is, for crawlers and agents: free, MIT, runs on the visitor's machine.
const software = {
  '@type': 'SoftwareApplication',
  '@id': new URL('/#software', site).href,
  name: siteName,
  description: ui.description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  softwareRequirements: 'Python 3.9 or later, git',
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

// The update is written once per voice; radio buttons pick which one shows (CSS only).
const voices = [
  { id: 'plain', label: ui.voicePlain },
  { id: 'pirate', label: ui.voicePirate },
  { id: 'genz', label: ui.voiceGenz },
  { id: 'corporate', label: ui.voiceCorporate },
  { id: 'oneliner', label: ui.voiceOneliner },
  { id: 'observational', label: ui.voiceObservational },
] as const;

const periods = [
  { id: 'day', label: ui.periodDay },
  { id: 'week', label: ui.periodWeek },
  { id: 'month', label: ui.periodMonth },
];

const sections = [
  { title: ui.askTitle, body: ui.askBody },
  { title: ui.agentsTitle, body: ui.agentsBody },
  { title: ui.projectsTitle, body: ui.projectsBody },
  { title: ui.readsTitle, body: ui.readsBody },
  { title: ui.weekTitle, body: ui.weekBody },
  { title: ui.numbersTitle, body: ui.numbersBody },
  { title: ui.closeTitle, body: ui.closeBody },
];
---

<BaseLayout locale={locale} title={siteNameFor(locale)} description={ui.description} graph={[software]}>
  <main id="main" class="mx-auto w-full max-w-xl flex-1 px-6 py-16 sm:py-24">
    <header class="motion-rise space-y-5">
      {/* The wordmark: "up" stands one x-height above "stand". */}
      <p class="text-4xl leading-none font-bold tracking-[-0.04em] sm:text-5xl">
        <bdi>
          stand<span class="align-[0.52em]">up</span>
        </bdi>
      </p>
      <h1 class="text-2xl text-balance sm:text-3xl">
        {ui.headline}
        <span class="block">{ui.headlineTurn}</span>
      </h1>
      <p
        id="lede"
        class="max-w-prose text-pretty text-[var(--color-muted)]"
        data-ledes={JSON.stringify(ledes)}
      >
        {ledes.evening.replace('{time}', '6:21pm')}
      </p>
    </header>

    <section class="motion-rise mt-10" style="animation-delay: 80ms" aria-labelledby="install-label">
      <h2 id="install-label" class="text-sm font-medium">
        {ui.installLabel}
      </h2>
      <div class="mt-2">
        <CodeBlock
          code={install.command}
          labelledby="install-label"
          copy={ui.copyCommand}
          copied={ui.copied}
          send={ui.sendLater}
          shell
          mark="standup"
        />
      </div>
      <p class="mt-2 text-sm text-[var(--color-muted)]">{ui.installNote}</p>
      <p class="mt-2 text-sm text-[var(--color-muted)]">{ui.installOther}</p>

      <h2 id="agent-label" class="mt-8 text-sm font-medium">
        {ui.agentPromptLabel}
      </h2>
      <div class="mt-2">
        <CodeBlock code={agentPrompt} labelledby="agent-label" copy={ui.copyPrompt} copied={ui.copied} />
      </div>
      <p class="mt-2 flex flex-wrap gap-x-5 text-sm">
        <a class="inline-block py-3" href="/llms.txt">
          {ui.llmsLink}
        </a>
        <a class="inline-block py-3" href={localePath(locale, '/') + 'index.md'}>
          {ui.markdownLink}
        </a>
      </p>
    </section>

    <section class="examples mt-14" aria-labelledby="example-title">
      <h2 id="example-title" class="text-lg text-balance">
        {ui.exampleTitle}
      </h2>

      <fieldset class="picker mt-4 flex flex-wrap gap-x-4 text-sm">
        <legend class="sr-only">{ui.periodLegend}</legend>
        {periods.map((period) => (
          <label class="cursor-pointer py-3">
            <input
              class="sr-only"
              type="radio"
              name="period"
              value={period.id}
              checked={period.id === 'day'}
            />
            <span>{period.label}</span>
          </label>
        ))}
      </fieldset>
      <fieldset class="picker flex flex-wrap gap-x-4 text-sm">
        <legend class="sr-only">{ui.voiceLegend}</legend>
        {voices.map((voice) => (
          <label class="cursor-pointer py-3">
            <input
              class="sr-only"
              type="radio"
              name="voice"
              value={voice.id}
              checked={voice.id === 'plain'}
            />
            <span>{voice.label}</span>
          </label>
        ))}
      </fieldset>

      {report.periods.map((period) => {
        // The numbered highlights and their notes explain the day. The week and the month read the same way.
        const noted = period.id === 'day';
        const Hi = noted ? 'mark' : Fragment;
        const n = (number: number) => noted && <sup>{number}</sup>;
        return (
          <div data-period={period.id}>
            <figure class="motion-enter mt-2">
              <figcaption class="text-sm text-[var(--color-muted)]">{ui.updateCaption}</figcaption>
              <div class="mt-2 border border-[var(--color-rule)] px-4 py-4 text-sm">
                <p class="font-bold">
                  <Hi>{period.title}</Hi>
                  {n(1)}
                </p>
                <ul class="mt-2 space-y-1.5">
                  {period.update.map((item, index) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true">•</span>
                      <span>
                        <span class="font-medium">{index === 0 ? <Hi>{item.title}</Hi> : item.title}</span>
                        {index === 0 && n(2)} {index === 1 ? <Hi>{item.status}</Hi> : item.status}
                        {index === 1 && n(3)}
                        {' → '}
                        {voices.map((voice) => (
                          <span data-voice={voice.id}>{item.text[voice.id]}</span>
                        ))}
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="mt-3">
                  <Hi>{period.footer}</Hi>
                  {n(4)}
                </p>
              </div>
              {noted && (
                <ol class="notes mt-3 space-y-1 text-sm text-[var(--color-muted)]">
                  <li>{ui.noteDate}</li>
                  <li>{ui.noteLines}</li>
                  <li>{ui.noteStatus}</li>
                  <li>{ui.noteFooter}</li>
                </ol>
              )}
              <p class="mt-3 text-sm text-[var(--color-muted)]">{ui.voiceNote}</p>
            </figure>

            <figure class="motion-enter mt-10">
              <figcaption class="text-sm text-[var(--color-muted)]">{ui.receiptCaption}</figcaption>
              <div class="mt-2 border-y border-dashed border-[var(--color-rule)] py-5 font-mono text-sm tabular-nums">
                <p class="font-bold">{period.title}</p>

                <table class="mt-5 w-full">
                  <caption class="text-start font-medium">
                    <Hi>{ui.receiptCommits}</Hi>
                    {n(5)}
                  </caption>
                  <tbody>
                    {period.commits.repos.map((repo) => (
                      <tr>
                        <th scope="row" class="py-0.5 ps-4 text-start font-normal">
                          {repo.name}
                        </th>
                        <td class="py-0.5 text-end">{repo.count}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>

                <table class="mt-5 w-full">
                  <caption class="text-start font-medium">
                    <Hi>{ui.receiptUncommitted}</Hi>
                    {n(6)}
                  </caption>
                  <tbody>
                    {period.uncommitted.map((repo) => (
                      <tr>
                        <th scope="row" class="py-0.5 ps-4 text-start font-normal">
                          {repo.name}
                        </th>
                        <td class="py-0.5 text-end">{repo.count}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>

                <table class="mt-5 w-full">
                  <caption class="text-start font-medium">{ui.receiptTokens}</caption>
                  <tbody>
                    <tr>
                      <th scope="row" class="py-0.5 ps-4 text-start font-normal">
                        <Hi>{ui.receiptOutput}</Hi>
                        {n(7)}
                      </th>
                      <td class="py-0.5 text-end">{period.tokens.output}</td>
                    </tr>
                    <tr>
                      <th scope="row" class="py-0.5 ps-4 text-start font-normal">
                        <Hi>{ui.receiptFresh}</Hi>
                        {n(7)}
                      </th>
                      <td class="py-0.5 text-end">{period.tokens.fresh}</td>
                    </tr>
                    <tr>
                      <th scope="row" class="py-0.5 ps-4 text-start font-normal">
                        <Hi>{ui.receiptCache}</Hi>
                        {n(8)}
                      </th>
                      <td class="py-0.5 text-end">{period.tokens.cache}</td>
                    </tr>
                    <tr>
                      <th scope="row" class="py-0.5 ps-4 text-start font-normal text-[var(--color-muted)]">
                        {ui.receiptAll}
                      </th>
                      <td class="py-0.5 text-end text-[var(--color-muted)]">{period.tokens.total}</td>
                    </tr>
                  </tbody>
                </table>

                <table class="mt-5 w-full">
                  <caption class="text-start font-medium">{ui.receiptModels}</caption>
                  <tbody>
                    {period.models.map((row) => (
                      <tr>
                        <th scope="row" class="py-0.5 ps-4 text-start font-normal">
                          {row.model}
                        </th>
                        <td class="py-0.5 text-end text-[var(--color-muted)]">
                          {row.output} {ui.receiptOutput}
                        </td>
                        <td class="w-20 py-0.5 text-end">{row.cost}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>

                <p class="mt-5 flex justify-between gap-4 border-t border-dashed border-[var(--color-rule)] pt-4">
                  <span class="text-[var(--color-muted)]">{ui.receiptTotal}</span>
                  <span class="font-bold whitespace-nowrap">
                    <Hi>{period.cost}</Hi>
                    {n(9)}
                  </span>
                </p>
              </div>
              {noted && (
                <ol start="5" class="notes mt-3 space-y-1 text-sm text-[var(--color-muted)]">
                  <li>{ui.noteRepos}</li>
                  <li>{ui.noteUncommitted}</li>
                  <li>{ui.noteWork}</li>
                  <li>{ui.noteCache}</li>
                  <li>{ui.noteCost}</li>
                </ol>
              )}
            </figure>
          </div>
        );
      })}
    </section>

    {sections.map((section) => (
      <section class="motion-enter mt-14 space-y-2">
        <h2 class="text-lg text-balance">{section.title}</h2>
        <p class="max-w-prose text-pretty text-[var(--color-muted)]">{section.body}</p>
      </section>
    ))}

    <footer class="mt-16 space-y-3 border-t border-[var(--color-rule)] pt-6 text-sm">
      <p class="text-[var(--color-muted)]">{ui.requirements}</p>
      <nav>
        <a class="inline-block py-3" href={localePath(locale, '/about/')}>
          {ui.about}
        </a>
      </nav>
    </footer>
  </main>
</BaseLayout>

<style>
  /* A highlight is a soft chip plus a number. The number carries it when the sun dial moves the colours. */
  .examples mark {
    background: var(--color-accent-soft);
    box-shadow: 0 0 0 0.15em var(--color-accent-soft);
    color: inherit;
  }
  .examples sup {
    margin-inline-start: 0.3em;
    font-size: 0.7em;
    font-weight: 700;
  }
  /* Plain shows unless another voice is picked. Browsers without :has() keep plain. */
  .examples [data-voice]:not([data-voice='plain']),
  .examples [data-period]:not([data-period='day']) {
    display: none;
  }
  .examples:has([value='week']:checked) [data-period='day'],
  .examples:has([value='month']:checked) [data-period='day'] {
    display: none;
  }
  .examples:has([value='week']:checked) [data-period='week'],
  .examples:has([value='month']:checked) [data-period='month'] {
    display: block;
  }
  .examples:has([value='pirate']:checked) [data-voice='plain'],
  .examples:has([value='genz']:checked) [data-voice='plain'],
  .examples:has([value='corporate']:checked) [data-voice='plain'],
  .examples:has([value='oneliner']:checked) [data-voice='plain'],
  .examples:has([value='observational']:checked) [data-voice='plain'] {
    display: none;
  }
  .examples:has([value='pirate']:checked) [data-voice='pirate'],
  .examples:has([value='genz']:checked) [data-voice='genz'],
  .examples:has([value='corporate']:checked) [data-voice='corporate'],
  .examples:has([value='oneliner']:checked) [data-voice='oneliner'],
  .examples:has([value='observational']:checked) [data-voice='observational'] {
    display: inline;
  }
  .picker {
    color: var(--color-muted);
  }
  .picker label:has(:checked) {
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: underline var(--color-accent) 2px;
    text-underline-offset: 0.3em;
  }
  .picker label:has(:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .notes {
    list-style: decimal;
    padding-inline-start: 1.5em;
  }
  .notes li::marker {
    font-weight: 700;
    color: var(--color-ink);
  }
</style>
