{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "site/public/favicon.svg",
  "scripts": [
    {
      "name": "Install",
      "command": "npm --prefix site install",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Dev",
      "command": "npm --prefix site run dev",
      "icon": "play",
      "previewUrl": "http://standup-site.localhost:4817/",
      "autoOpenPreview": true
    },
    { "name": "Build", "command": "npm --prefix site run build", "icon": "build" },
    { "name": "Preview", "command": "npm --prefix site run build && npm --prefix site run preview", "icon": "play" },
    { "name": "Check setup", "command": "python3 plugin/skills/standup/standup.py --check", "icon": "configure" },
    { "name": "Today's report", "command": "python3 plugin/skills/standup/standup.py --unit work", "icon": "play" }
  ]
}
