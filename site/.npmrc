; Exact versions in package.json, no ^ or ~.
save-exact=true
; Refuse a package published in the last 2 days: a hijacked release is usually pulled by then.
; npm ci installs from the lockfile and is never held back.
min-release-age=2
; Dependencies come from the registry only, never a git repo or a URL.
allow-git=none
allow-remote=none
