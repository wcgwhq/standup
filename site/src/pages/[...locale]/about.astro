---
import BrandBar from '@/components/BrandBar.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { copy, localePath, localeStaticPaths } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const ui = copy(locale);
---

<BaseLayout locale={locale} title={ui.aboutTitle} description={ui.aboutDescription} pageType="AboutPage">
  <main id="main" class="mx-auto w-full max-w-xl flex-1 px-6 py-16">
    <div class="mb-10">
      <BrandBar facts={ui.brandFacts} href={localePath(locale)} homeLabel={ui.backHome} />
    </div>
    <article class="space-y-3">
      <h1 class="text-3xl">{ui.aboutTitle}</h1>
      <p class="max-w-prose text-pretty text-[var(--color-muted)]">{ui.aboutBody}</p>
      <p class="max-w-prose text-pretty text-[var(--color-muted)]">
        {ui.aboutPrivacy} <a href={localePath(locale, '/privacy/')}>{ui.privacy}</a>{' '}
        <button type="button" class="link" data-consent-reset>
          {ui.consentReset}
        </button>
      </p>
    </article>
  </main>
</BaseLayout>
