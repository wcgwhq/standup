  /* The paper is as wide as the slot and starts inside it (percentages are of the printer's width).
     It hangs in front of the lower half of the box and throws a little shade on it. */
  .receipt-feed {
    position: relative;
    margin: -19.2% 8.2% 0;
    overflow: clip;
  }
  .receipt-feed::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
