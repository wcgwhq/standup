---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { copy, localePath, localeStaticPaths } from '@/i18n';
import { organizationId } from '@/lib/seo';
import CodeBlock from '@/components/CodeBlock.astro';
import AgentIcon from '@/components/AgentIcon.astro';
import { siteName } from '../../../site.config.mjs';
import install from '@/data/install.json';
import report from '@/data/sample-report.json';
import sources from '@/data/sources.json';
import plugin from '../../../../plugin/.claude-plugin/plugin.json';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const ui = copy(locale);

// One lede per part of the day; SunDial.astro picks by the time on the dial.
const ledes = {
  morning: ui.ledeMorning,
  midmorning: ui.ledeMidmorning,
  afternoon: ui.ledeAfternoon,
  evening: ui.ledeEvening,
  night: ui.ledeNight,
};

const site = Astro.site!;
const llms = new URL('/llms.txt', site).href;
const agentPrompt = ui.agentPrompt.replace('{llms}', llms);
const repo = `https://github.com/${install.repo}`;

// What the plugin is, for crawlers and agents: free, MIT, runs on the visitor's machine.
const software = {
  '@type': 'SoftwareApplication',
  '@id': new URL('/#software', site).href,
  name: siteName,
  description: ui.description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  softwareRequirements: 'Python 3.9 or later, git',
  softwareVersion: plugin.version,
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  downloadUrl: repo,
  sameAs: repo,
  author: { '@id': organizationId(site) },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

// The update is written once per voice; radio buttons pick which one shows (CSS only).
const voices = [
  { id: 'plain', label: ui.voicePlain },
  { id: 'pirate', label: ui.voicePirate },
  { id: 'genz', label: ui.voiceGenz },
  { id: 'corporate', label: ui.voiceCorporate },
  { id: 'oneliner', label: ui.voiceOneliner },
  { id: 'observational', label: ui.voiceObservational },
] as const;

const periods = [
  { id: 'day', label: ui.periodDay },
  { id: 'week', label: ui.periodWeek },
  { id: 'month', label: ui.periodMonth },
];

// One install command per agent, each that agent's own route (src/data/install.json).
const installs = install.agents.map((agent) => ({
  ...agent,
  command: agent.command.replace('{repo}', install.repo),
  note:
    agent.id === 'claude'
      ? ''
      : agent.id === 'cursor'
        ? ui.installCursor
        : agent.command.startsWith('git clone')
          ? ui.installCopy
          : ui.installOther,
}));

const sourceKind = {
  commits: ui.sourceCommits,
  tokens: ui.sourceTokens,
  sessions: ui.sourceSessions,
} as Record<string, string>;

// Three stubs torn from one report: each group goes to its own reader.
const stubs = [
  { group: ui.stubWork, reader: ui.stubToManager },
  { group: ui.stubConsulting, reader: ui.stubToClient },
  { group: ui.stubPersonal, reader: ui.stubToNobody },
];

// The week this page was built, as bars. A day that has not happened has no bar.
const weekday = new Intl.DateTimeFormat(locale, { weekday: 'short', timeZone: 'UTC' });
const busiest = Math.max(...report.week_days.map((day) => day.commits ?? 0));
const week = report.week_days.map((day) => ({
  label: weekday.format(new Date(day.date)),
  commits: day.commits,
  height: day.commits ? Math.max(4, Math.round((day.commits / busiest) * 100)) : 0,
}));

// Where a day's tokens went, as shares of one bar.
const split = report.token_split;
const allTokens = split.output + split.fresh + split.cache;
const share = (count: number) => (count / allTokens) * 100;
const parts = [
  { key: 'cache', label: ui.receiptCache, share: share(split.cache) },
  { key: 'fresh', label: ui.receiptFresh, share: share(split.fresh) },
  { key: 'output', label: ui.receiptOutput, share: share(split.output) },
];
const percent = (value: number) => (value >= 10 ? Math.round(value) : value.toFixed(1)) + '%';
---

<BaseLayout locale={locale} title={ui.homeTitle} description={ui.description} graph={[software]}>
  <main id="main" class="mx-auto w-full max-w-xl flex-1 px-6 py-16 sm:py-24">
    <header class="motion-rise space-y-5">
      {/* The wordmark: "up" stands one x-height above "stand". */}
      <p class="text-4xl leading-none font-bold tracking-[-0.04em] sm:text-5xl">
        <bdi>
          stand<span class="align-[0.52em]">up</span>
        </bdi>
      </p>
      <h1 class="text-2xl text-balance sm:text-3xl">
        {/* From 768px the first sentence stays on one line, even where it runs past the column. */}
        <span class="md:whitespace-nowrap">{ui.headline}</span> <span class="block">{ui.headlineTurn}</span>
      </h1>
      <p
        id="lede"
        class="max-w-prose text-pretty text-[var(--color-muted)]"
        data-ledes={JSON.stringify(ledes)}
      >
        {ledes.evening.replace('{time}', '6:21pm')}
      </p>
    </header>

    <section class="install motion-rise mt-10" style="animation-delay: 80ms" aria-labelledby="install-label">
      <h2 id="install-label" class="text-sm font-medium">
        {ui.installLabel}
      </h2>
      <fieldset class="picker picker-agents mt-3 mb-3">
        <legend class="sr-only">{ui.agentLegend}</legend>
        {installs.map((agent) => (
          <label>
            <input
              class="sr-only"
              type="radio"
              name="agent"
              value={agent.id}
              checked={agent.id === 'claude'}
            />
            <AgentIcon agent={agent.id} />
            <span class="picker-name">{agent.name}</span>
          </label>
        ))}
      </fieldset>
      {installs.map((agent) => (
        <div data-agent={agent.id} data-md-label={agent.name}>
          <CodeBlock
            code={agent.command}
            labelledby="install-label"
            copy={ui.copyCommand}
            copied={ui.copied}
            send={ui.sendLater}
            shell
            mark="standup"
          />
          {agent.note && <p class="mt-2 text-sm text-[var(--color-muted)]">{agent.note}</p>}
        </div>
      ))}
      <p class="mt-2 text-sm text-[var(--color-muted)]">{ui.installNote}</p>

      <h2 id="agent-label" class="mt-8 text-sm font-medium">
        {ui.agentPromptLabel}
      </h2>
      <div class="mt-2">
        <CodeBlock code={agentPrompt} labelledby="agent-label" copy={ui.copyPrompt} copied={ui.copied} />
      </div>
      <p class="mt-2 flex flex-wrap gap-x-5 text-sm">
        <a class="inline-block py-3" href="/llms.txt">
          {ui.llmsLink}
        </a>{' '}
        <a class="inline-block py-3" href={localePath(locale, '/') + 'index.md'}>
          {ui.markdownLink}
        </a>
      </p>
    </section>

    <section class="examples mt-14" aria-labelledby="example-title">
      <h2 id="example-title" class="text-lg text-balance">
        {ui.exampleTitle}
      </h2>

      {/* The printer's paint, shared by the three printers below. */}
      <svg class="absolute h-0 w-0" aria-hidden="true">
        <defs>
          <linearGradient id="printer-top" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--color-printer-light)"></stop>
            <stop offset="1" stop-color="var(--color-printer)"></stop>
          </linearGradient>
          <linearGradient id="printer-front" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--color-printer)"></stop>
            <stop offset="1" stop-color="var(--color-printer-dark)"></stop>
          </linearGradient>
          <linearGradient id="printer-slot" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#000"></stop>
            <stop offset="1" stop-color="var(--color-printer-deep)"></stop>
          </linearGradient>
        </defs>
      </svg>

      <fieldset class="picker mt-5">
        <legend class="sr-only">{ui.periodLegend}</legend>
        {periods.map((period) => (
          <label>
            <input
              class="sr-only"
              type="radio"
              name="period"
              value={period.id}
              checked={period.id === 'day'}
            />
            <span>{period.label}</span>
          </label>
        ))}
      </fieldset>
      <fieldset class="picker mt-2 mb-5">
        <legend class="sr-only">{ui.voiceLegend}</legend>
        {voices.map((voice) => (
          <label>
            <input
              class="sr-only"
              type="radio"
              name="voice"
              value={voice.id}
              checked={voice.id === 'plain'}
            />
            <span>{voice.label}</span>
          </label>
        ))}
      </fieldset>

      {report.periods.map((period) => {
        // The numbered highlights and their notes explain the day. The week and the month read the same way.
        const noted = period.id === 'day';
        const Hi = noted ? 'mark' : Fragment;
        const n = (number: number) => noted && <sup>{number}</sup>;
        return (
          <div data-period={period.id}>
            <figure class="motion-enter mt-2">
              <figcaption class="text-sm text-[var(--color-muted)]">{ui.updateCaption}</figcaption>
              <div class="mt-2 border border-[var(--color-rule)] px-4 py-4 text-sm">
                <p class="font-bold">
                  <Hi>{period.title}</Hi>
                  {n(1)}
                </p>
                <ul class="mt-2 space-y-1.5">
                  {period.update.map((item, index) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true">•</span>
                      <span>
                        <span class="font-medium">{index === 0 ? <Hi>{item.title}</Hi> : item.title}</span>
                        {index === 0 && n(2)} {index === 1 ? <Hi>{item.status}</Hi> : item.status}
                        {index === 1 && n(3)}
                        {' → '}
                        {voices.map((voice) => (
                          <span data-voice={voice.id} data-md={voice.id === 'plain' ? undefined : 'skip'}>
                            {item.text[voice.id]}
                          </span>
                        ))}
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="mt-3">
                  <Hi>{period.footer}</Hi>
                  {n(4)}
                </p>
              </div>
              {noted && (
                <ol class="notes mt-3 space-y-1 text-sm text-[var(--color-muted)]">
                  <li>{ui.noteDate}</li>
                  <li>{ui.noteLines}</li>
                  <li>{ui.noteStatus}</li>
                  <li>{ui.noteFooter}</li>
                </ol>
              )}
              <p class="mt-3 text-sm text-[var(--color-muted)]">{ui.voiceNote}</p>
            </figure>

            <figure class="receipt mt-10" data-tilt>
              <figcaption class="text-sm text-[var(--color-muted)]">{ui.receiptCaption}</figcaption>
              {/* A chunky thermal printer seen from a little above: lid on top, slot on the front. The receipt feeds out of the slot. */}
              <div class="printer-wrap relative mt-3">
                {/* The feed key is a real button: press it and the receipt prints again. */}
                <button
                  class="printer-press"
                  type="button"
                  aria-label={ui.printAgain}
                  title={ui.printAgain}
                  hidden
                ></button>
                <svg class="printer block w-full" viewBox="0 0 320 150" aria-hidden="true">
                  <ellipse class="printer-shadow" cx="160" cy="133" rx="156" ry="12"></ellipse>
                  {/* front face */}
                  <path
                    class="printer-front"
                    d="M6 68H314V112a18 18 0 0 1-18 18H24a18 18 0 0 1-18-18Z"
                  ></path>
                  {/* lid */}
                  <path
                    class="printer-top"
                    d="M44 14H276a12 12 0 0 1 11 7L314 68H6L33 21a12 12 0 0 1 11-7Z"
                  ></path>
                  <path class="printer-edge" d="M7 68H313"></path>
                  {/* smoked window over the paper roll */}
                  <path class="printer-window" d="M92 24H228l10 30H82Z"></path>
                  <path class="printer-roll" d="M100 46q60-16 120 0"></path>
                  <path class="printer-glint" d="M100 28h44l-6 22H93Z"></path>
                  {/* feed key and light */}
                  <ellipse class="printer-key-side" cx="268" cy="43" rx="15" ry="6.5"></ellipse>
                  <ellipse class="printer-key" cx="268" cy="40" rx="15" ry="6.5"></ellipse>
                  <circle class="printer-halo" cx="50" cy="42" r="7"></circle>
                  <ellipse class="printer-led" cx="50" cy="42" rx="4" ry="2.6"></ellipse>
                  {/* tear bar, slot, and the name on the lid's front lip */}
                  <path
                    class="printer-teeth"
                    d="M24 82l4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4 4-4 4 4"
                  ></path>
                  <rect class="printer-slot" x="20" y="82" width="280" height="14" rx="5"></rect>
                  <text class="printer-name" x="160" y="63.5" text-anchor="middle">
                    ALIBI 3000
                  </text>
                </svg>
              </div>
              <div class="receipt-feed">
                <div class="receipt-paper px-3 pt-7 pb-2 sm:px-4 font-mono text-xs tabular-nums min-[400px]:text-[0.8125rem]">
                  <p class="font-bold">{period.title}</p>

                  <table class="mt-5 w-full">
                    <caption class="text-start font-medium">
                      <Hi>{ui.receiptCommits}</Hi>
                      {n(5)}
                    </caption>
                    <tbody>
                      {period.commits.repos.map((repo) => (
                        <tr>
                          <th scope="row" class="py-0.5 ps-4 text-start font-normal">
                            {repo.name}
                          </th>
                          <td class="py-0.5 text-end">{repo.count}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>

                  <table class="mt-5 w-full">
                    <caption class="text-start font-medium">
                      <Hi>{ui.receiptUncommitted}</Hi>
                      {n(6)}
                    </caption>
                    <tbody>
                      {period.uncommitted.map((repo) => (
                        <tr>
                          <th scope="row" class="py-0.5 ps-4 text-start font-normal">
                            {repo.name}
                          </th>
                          <td class="py-0.5 text-end">{repo.count}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>

                  <table class="mt-5 w-full">
                    <caption class="text-start font-medium">{ui.receiptTokens}</caption>
                    <tbody>
                      <tr>
                        <th scope="row" class="py-0.5 ps-4 text-start font-normal">
                          <Hi>{ui.receiptOutput}</Hi>
                          {n(7)}
                        </th>
                        <td class="py-0.5 text-end">{period.tokens.output}</td>
                      </tr>
                      <tr>
                        <th scope="row" class="py-0.5 ps-4 text-start font-normal">
                          <Hi>{ui.receiptFresh}</Hi>
                          {n(7)}
                        </th>
                        <td class="py-0.5 text-end">{period.tokens.fresh}</td>
                      </tr>
                      <tr>
                        <th scope="row" class="py-0.5 ps-4 text-start font-normal">
                          <Hi>{ui.receiptCache}</Hi>
                          {n(8)}
                        </th>
                        <td class="py-0.5 text-end">{period.tokens.cache}</td>
                      </tr>
                      <tr>
                        <th scope="row" class="py-0.5 ps-4 text-start font-normal text-[var(--color-muted)]">
                          {ui.receiptAll}
                        </th>
                        <td class="py-0.5 text-end text-[var(--color-muted)]">{period.tokens.total}</td>
                      </tr>
                    </tbody>
                  </table>

                  <table class="mt-5 w-full">
                    <caption class="text-start font-medium">{ui.receiptModels}</caption>
                    <tbody>
                      {period.models.map((row) => (
                        <tr>
                          <th scope="row" class="py-0.5 ps-4 text-start font-normal">
                            {row.model}
                          </th>
                          <td class="py-0.5 text-end text-[var(--color-muted)]">
                            {row.output} {ui.receiptOutput}
                          </td>
                          <td class="w-16 py-0.5 text-end">{row.cost}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>

                  <p class="mt-5 flex justify-between gap-4 border-t border-dashed border-[var(--color-rule)] pt-4">
                    <span class="text-[var(--color-muted)]">{ui.receiptTotal}</span>
                    <span class="font-bold whitespace-nowrap">
                      <Hi>{period.cost}</Hi>
                      {n(9)}
                    </span>
                  </p>
                </div>
              </div>
              {noted && (
                <ol start="5" class="notes mt-3 space-y-1 text-sm text-[var(--color-muted)]">
                  <li>{ui.noteRepos}</li>
                  <li>{ui.noteUncommitted}</li>
                  <li>{ui.noteWork}</li>
                  <li>{ui.noteCache}</li>
                  <li>{ui.noteCost}</li>
                </ol>
              )}
            </figure>
          </div>
        );
      })}
    </section>

    <section class="motion-enter mt-24">
      <h2 class="text-2xl text-balance sm:text-3xl">{ui.askTitle}</h2>
      <p class="mt-4 max-w-prose text-pretty text-[var(--color-muted)]">{ui.askBody}</p>
      <p class="mt-3 max-w-prose text-pretty">{ui.readsBody}</p>
    </section>

    <section class="motion-enter mt-20" aria-labelledby="sources-title">
      <h2 id="sources-title" class="text-lg text-balance">
        {ui.agentsTitle}
      </h2>
      {/* The intake: a graphite panel seen from the printer's angle, one lamp per source. */}
      <div class="intake tilt mt-5" data-tilt>
        <svg class="block w-full" viewBox="0 0 320 34" aria-hidden="true">
          <path class="intake-top" d="M40 4H280a10 10 0 0 1 9 5L314 34H6L31 9a10 10 0 0 1 9-5Z"></path>
          <path class="intake-vents" d="M120 14h80M114 20h92M108 26h104"></path>
        </svg>
        <ul class="intake-face font-mono text-xs min-[400px]:text-sm">
          {sources.sources.map((source) => (
            <li
              class="flex items-center gap-3 py-2"
              data-md-text={`${source.name}: ${sourceKind[source.kind]}`}
            >
              <span
                class="lamp"
                data-kind={source.kind}
                style={`--i: ${sources.sources.indexOf(source)}`}
                aria-hidden="true"
              />
              <span class:list={[source.kind === 'commits' && 'font-bold']}>{source.name}</span>
              <span class="intake-groove flex-1" aria-hidden="true" />
              <span class="intake-kind">{sourceKind[source.kind]}</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-6 max-w-prose text-sm text-pretty text-[var(--color-muted)]">{ui.sourcesNote}</p>
    </section>

    <section class="motion-enter mt-20" aria-labelledby="projects-title">
      <h2 id="projects-title" class="text-lg text-balance">
        {ui.projectsTitle}
      </h2>
      <p class="mt-2 max-w-prose text-pretty text-[var(--color-muted)]">{ui.projectsBody}</p>
      {/* Three stubs torn off one report, dropped on the desk. */}
      <ul class="stubs mt-8 grid grid-cols-3 gap-3 font-mono text-xs sm:gap-5 sm:text-sm">
        {stubs.map((stub) => (
          <li data-md-text={`${stub.group}: ${stub.reader}`}>
            <span class="block px-3 pt-4 pb-3 font-bold">{stub.group}</span>
            <span class="stub-tear block px-3 pt-3 pb-4 text-[var(--color-muted)]">{stub.reader}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="motion-enter mt-24" aria-labelledby="week-title">
      <h2 id="week-title" class="text-lg text-balance">
        {ui.weekTitle}
      </h2>
      {/* A pile of paper per day: the taller the pile, the more commits. */}
      <ol
        class="week mt-8 grid grid-cols-7 gap-3 font-mono text-xs tabular-nums"
        aria-label={ui.weekCommits}
        data-reveal
      >
        {week.map((day, index) => (
          <li
            class="flex flex-col items-center gap-1.5"
            style={`--i: ${index}`}
            data-md-text={`${day.label}: ${day.commits ?? '·'}`}
          >
            <span class="flex h-28 w-full items-end">
              {day.height > 0 ? (
                <span class="pile" style={`height: ${day.height}%`} />
              ) : (
                <span class="tray" />
              )}
            </span>
            <span>{day.commits ?? '·'}</span>
            <span class="text-[var(--color-muted)]">{day.label}</span>
          </li>
        ))}
      </ol>
      <p class="mt-5 max-w-prose text-pretty text-[var(--color-muted)]">{ui.weekBody}</p>
    </section>

    <section class="motion-enter mt-20" aria-labelledby="cost-title">
      <h2 id="cost-title" class="text-lg text-balance">
        {ui.numbersTitle}
      </h2>
      <figure class="mt-5">
        <figcaption class="text-sm text-[var(--color-muted)]">{ui.splitLabel}</figcaption>
        {/* One moulded slab, cut where the tokens went. */}
        <div class="slab tilt mt-5 flex h-7" aria-hidden="true" data-tilt data-reveal>
          {parts.map((part) => (
            <span data-part={part.key} style={`flex: ${part.share} 0 4px`} />
          ))}
        </div>
        <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs tabular-nums">
          {parts.map((part) => (
            <li class="flex items-center gap-1.5">
              <span class="slab-key" data-part={part.key} aria-hidden="true" />
              {percent(part.share)} {part.label}
            </li>
          ))}
        </ul>
      </figure>
      <p class="mt-4 max-w-prose text-pretty text-[var(--color-muted)]">{ui.numbersBody}</p>
    </section>

    <section class="motion-enter mt-24" aria-labelledby="close-title">
      <h2 id="close-title" class="text-2xl text-balance sm:text-3xl">
        {ui.closeTitle}
      </h2>
      <p class="mt-4 max-w-prose text-pretty text-[var(--color-muted)]">{ui.closeBody}</p>
      <div class="mt-6">
        <CodeBlock
          code={install.command}
          labelledby="close-title"
          copy={ui.copyCommand}
          copied={ui.copied}
          send={ui.sendLater}
          shell
          mark="standup"
        />
      </div>
    </section>

    <footer class="mt-16 space-y-3 border-t border-[var(--color-rule)] pt-6 text-sm">
      <p class="text-[var(--color-muted)]">{ui.requirements}</p>
      <nav>
        <ul class="flex flex-wrap gap-x-5">
          {installs
            .filter((agent) => 'slug' in agent)
            .map((agent) => (
              <li>
                <a class="inline-block py-3" href={localePath(locale, `/${agent.slug}/`)}>
                  {agent.name}
                </a>
              </li>
            ))}
          <li>
            <a class="inline-block py-3" href={localePath(locale, '/about/')}>
              {ui.about}
            </a>
          </li>
        </ul>
      </nav>
    </footer>
  </main>
</BaseLayout>

<style>
