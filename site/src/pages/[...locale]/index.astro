  .lamp {
    animation: flicker 3.1s steps(1, end) infinite;
    animation-delay: calc(var(--i, 0) * -0.43s);
  }
  .lamp[data-kind='sessions'] {
    animation-duration: 5.3s;
  }
  .lamp[data-kind='commits'] {
    animation: none;
  }
  @keyframes flicker {
    0%,
    100% {
      opacity: 1;
    }
    6% {
      opacity: 0.35;
    }
    9% {
      opacity: 1;
    }
    41% {
      opacity: 0.5;
    }
    44% {
      opacity: 1;
    }
    47% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }
  /* A pile of paper: sheet edges on the front, a top face and a side face. */
  .pile {
    position: relative;
    width: calc(100% - 8px);
    border-inline: 1px solid var(--color-rule);
    background: repeating-linear-gradient(var(--color-paper) 0 2px, var(--color-rule) 2px 3px);
    filter: drop-shadow(0 6px 4px rgb(0 0 0 / 0.22));
  }
  .pile::before {
    content: '';
    position: absolute;
    inset: auto -1px 100%;
    height: 8px;
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
    transform: skewX(-45deg);
    transform-origin: bottom left;
  }
  .pile::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 100%;
    width: 8px;
    background: repeating-linear-gradient(
      color-mix(in srgb, var(--color-paper), var(--color-ink) 14%) 0 2px,
      color-mix(in srgb, var(--color-rule), var(--color-ink) 22%) 2px 3px
    );
    transform: skewY(-45deg);
    transform-origin: top left;
  }
  /* When the week scrolls into view the piles stack up sheet by sheet, Monday first. */
  .will-reveal .pile {
    clip-path: inset(100% -12px 0 -12px);
  }
  .is-in .pile {
    animation: stack 0.9s steps(14, end) both;
    animation-delay: calc(var(--i, 0) * 0.18s);
  }
  @keyframes stack {
    from {
      clip-path: inset(100% -12px 0 -12px);
    }
    to {
      clip-path: inset(-12px);
    }
  }
  /* The slab slides out from the left. */
  .slab.will-reveal {
    clip-path: inset(-14px 100% -20px 0);
  }
  .slab.is-in {
    animation: extrude 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes extrude {
    from {
      clip-path: inset(-14px 100% -20px 0);
    }
    to {
      clip-path: inset(-14px -14px -20px 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lamp,
    .printer-halo,
    .printer-roll,
    .is-in .pile,
    .slab.is-in {
      animation: none;
    }
    .will-reveal .pile,
    .slab.will-reveal {
      clip-path: none;
    }
  }
  .tray {
    width: calc(100% - 8px);
    height: 3px;
    border-radius: 2px;
    background: var(--color-rule);
  }
  /* The slab: three blocks with a top face each and one end face. Graphite for the cache, orange for the work. */
  .slab {
    padding-inline-end: 10px;
    filter: drop-shadow(0 10px 6px rgb(0 0 0 / 0.25));
  }
  .slab span {
    position: relative;
    background: var(--front);
  }
  .slab span::before {
    content: '';
    position: absolute;
    inset: auto 0 100%;
    height: 10px;
    background: var(--top);
    transform: skewX(-45deg);
    transform-origin: bottom left;
  }
  .slab span:last-child::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 100%;
    width: 10px;
    background: var(--side);
    transform: skewY(-45deg);
    transform-origin: top left;
  }
  [data-part='cache'] {
    --front: var(--color-gear);
    --top: var(--color-gear-light);
    --side: var(--color-gear-dark);
  }
  [data-part='fresh'] {
    --front: var(--color-printer-light);
    --top: #ffb596;
    --side: var(--color-printer);
  }
  [data-part='output'] {
    --front: var(--color-printer);
    --top: var(--color-printer-light);
    --side: var(--color-printer-dark);
  }
  .slab-key {
    width: 0.6rem;
    height: 0.6rem;
    background: var(--front);
  }
  .notes {
    list-style: decimal;
    padding-inline-start: 1.5em;
  }
  .notes li::marker {
    font-weight: 700;
    color: var(--color-ink);
  }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const examples = document.querySelector<HTMLElement>('.examples');

  // The receipt feeds out of the printer the first time a printer scrolls into view.
  if (examples && 'IntersectionObserver' in window) {
    examples.classList.add('will-print');
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        examples.classList.add('is-printing');
        seen.disconnect();
      },
      { rootMargin: '0px 0px -25% 0px' },
    );
    for (const printer of examples.querySelectorAll('.printer')) seen.observe(printer);
  }

  // The feed key prints the receipt again: the class comes off, the page takes a breath, it goes back on.
  for (const key of document.querySelectorAll<HTMLButtonElement>('.printer-press')) {
    if (!examples || still) continue;
    key.hidden = false;
    key.addEventListener('click', () => {
      examples.classList.remove('is-printing');
      void examples.offsetWidth;
      examples.classList.add('is-printing');
    });
  }

  // Piles and the slab build themselves when they scroll into view.
  if ('IntersectionObserver' in window && !still) {
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          reveal.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -15% 0px' },
    );
    for (const block of document.querySelectorAll('[data-reveal]')) {
      block.classList.add('will-reveal');
      reveal.observe(block);
    }
  }
</script>
