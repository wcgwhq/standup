<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const examples = document.querySelector<HTMLElement>('.examples');

  // The receipt feeds out of the printer the first time a printer scrolls into view.
  if (examples && 'IntersectionObserver' in window) {
    examples.classList.add('will-print');
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        examples.classList.add('is-printing');
        seen.disconnect();
      },
      { rootMargin: '0px 0px -25% 0px' },
    );
    for (const printer of examples.querySelectorAll('.printer')) seen.observe(printer);
  }

  // The feed key prints the receipt again: the class comes off, the page takes a breath, it goes back on.
  for (const key of document.querySelectorAll<HTMLButtonElement>('.printer-press')) {
    if (!examples || still) continue;
    key.hidden = false;
    key.addEventListener('click', () => {
      examples.classList.remove('is-printing');
      void examples.offsetWidth;
      examples.classList.add('is-printing');
    });
  }

  // Piles and the slab build themselves when they scroll into view.
  if ('IntersectionObserver' in window && !still) {
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          reveal.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -15% 0px' },
    );
    for (const block of document.querySelectorAll('[data-reveal]')) {
      block.classList.add('will-reveal');
      reveal.observe(block);
    }
  }

  // With a mouse, the objects lean toward the pointer.
  if (matchMedia('(hover: hover)').matches && !still) {
    for (const object of document.querySelectorAll<HTMLElement>('[data-tilt]')) {
      object.addEventListener('pointermove', (event) => {
        const box = object.getBoundingClientRect();
        object.style.setProperty('--tx', (((event.clientX - box.left) / box.width) * 2 - 1).toFixed(2));
        object.style.setProperty('--ty', (((event.clientY - box.top) / box.height) * 2 - 1).toFixed(2));
      });
      object.addEventListener('pointerleave', () => {
        object.style.removeProperty('--tx');
        object.style.removeProperty('--ty');
      });
    }
  }
