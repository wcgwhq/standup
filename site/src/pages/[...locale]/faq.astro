---
import BrandBar from '@/components/BrandBar.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { copy, localePath, localeStaticPaths } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const ui = copy(locale);

/** Each group's heading key and its questions: `faq<n>Q` and `faq<n>A` in src/i18n. */
const groups: [string, number[]][] = [
  ['faqBasics', [1, 2, 3, 4]],
  ['faqUsing', [5, 6, 7, 8, 9]],
  ['faqNumbers', [10, 11, 12]],
  ['faqPrivacy', [13, 14]],
  ['faqInstall', [15, 16, 17]],
];
const privacyQuestions = [13];

/** Backticks in an answer are inline code. */
const parts = (text: string) => text.split('`');
const plain = (text: string) => text.replaceAll('`', '');

const faqPage = {
  '@type': 'FAQPage',
  mainEntity: groups.flatMap(([, ids]) =>
    ids.map((id) => ({
      '@type': 'Question',
      name: ui[`faq${id}Q`],
      acceptedAnswer: { '@type': 'Answer', text: plain(ui[`faq${id}A`]) },
    })),
  ),
};
---

<BaseLayout locale={locale} title={ui.faqTitle} description={ui.faqDescription} graph={[faqPage]}>
  <main id="main" class="mx-auto w-full max-w-xl flex-1 px-6 py-16">
    <div class="mb-10">
      <BrandBar facts={ui.brandFacts} href={localePath(locale)} homeLabel={ui.backHome} />
    </div>
    <article class="doc">
      <h1 class="text-3xl">{ui.faqTitle}</h1>
      <p class="doc-lede">
        {ui.faqLede}{' '}
        <a href="https://github.com/wcgwhq/standup/blob/main/plugin/README.md" rel="noopener">
          {ui.faqReference}
        </a>
      </p>
      {groups.map(([heading, ids]) => (
        <section>
          <h2>{ui[heading]}</h2>
          {ids.map((id) => (
            <>
              <h3 id={`q${id}`}>{ui[`faq${id}Q`]}</h3>
              <p>
                {parts(ui[`faq${id}A`]).map((part, index) => (index % 2 ? <code>{part}</code> : part))}
                {privacyQuestions.includes(id) && (
                  <>
                    {' '}
                    <a href={localePath(locale, '/privacy/')}>{ui.faqPrivacyLink}</a>
                  </>
                )}
              </p>
            </>
          ))}
        </section>
      ))}
    </article>
  </main>
</BaseLayout>
