---
/**
 * The footer every page ends with: who publishes Standup and where to find them.
 * Plain on purpose: a hairline, one line of credit and three links, in the page's own
 * column and colours. It also leaves room for the sun dial under the page.
 */
const links = [
  { label: 'wcgw.fun', href: 'https://wcgw.fun' },
  { label: '@wcgwfun', href: 'https://x.com/wcgwfun' },
  { label: '@raduceuca', href: 'https://x.com/raduceuca' },
];
---

<footer class="dial-clearance mx-auto w-full max-w-xl px-6 pt-2">
  <div class="border-t border-[var(--color-rule)] pt-6 text-sm text-[var(--color-muted)]">
    <p>
      <bdi>What Could Go Wrong</bdi>. Tools for the aftermath. © 2026
    </p>
    <ul class="flex flex-wrap gap-x-5">
      {links.map((link) => (
        <li>
          <a class="inline-block min-w-11 py-3" href={link.href} rel="noopener">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
