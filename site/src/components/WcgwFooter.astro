---
/**
 * The WCGW footer every WCGW site carries: the links panel, the arcade and the
 * "What could go wrong?" plate (the plate is drawn by the arcade itself).
 * Adapted from slopmeter-ai's Footer.tsx without Slopmeter's own mark and tagline.
 * It is a dark band at every hour: the arcade has its own palette and the sun
 * dial does not repaint it. The band also leaves room for the dial under the page.
 */
import { WhackAMole } from './wcgw/WhackAMole';

const links = [
  { label: 'WCGW', href: 'https://wcgw.fun', upper: true },
  { label: 'Claudecraft', href: 'https://claudecraft.dev', upper: true },
  { label: '@wcgwfun', href: 'https://x.com/wcgwfun' },
  { label: '@raduceuca', href: 'https://x.com/raduceuca' },
];
---

<footer class="wcgw-footer dial-clearance bg-[var(--color-arcade)] pt-10 text-neutral-500">
  <div class="mb-1 px-4 sm:px-8" style="perspective: 600px">
    <div class="wcgw-panel relative mx-auto max-w-xl border border-neutral-800/50 font-mono select-none">
      <span
        class="absolute top-1.5 left-1.5 h-2.5 w-2.5 border-t border-l border-neutral-700/40"
        aria-hidden="true"
      ></span>
      <span
        class="absolute top-1.5 right-1.5 h-2.5 w-2.5 border-t border-r border-neutral-700/40"
        aria-hidden="true"
      ></span>
      <span
        class="absolute bottom-1.5 left-1.5 h-2.5 w-2.5 border-b border-l border-neutral-700/40"
        aria-hidden="true"
      ></span>
      <span
        class="absolute right-1.5 bottom-1.5 h-2.5 w-2.5 border-r border-b border-neutral-700/40"
        aria-hidden="true"
      ></span>
      <ul class="flex flex-wrap items-center justify-center gap-x-5 text-xs">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              rel="noopener"
              class:list={['inline-block py-4 tracking-wider', link.upper && 'uppercase']}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <WhackAMole client:visible className="px-4 sm:px-8 pb-4" />
</footer>

<style>
  .wcgw-panel {
    transform: rotateX(18deg);
    transform-origin: center bottom;
    background-image:
      linear-gradient(90deg, rgb(82 82 82 / 0.07) 1px, transparent 1px),
      linear-gradient(0deg, rgb(82 82 82 / 0.04) 1px, transparent 1px);
    background-size:
      48px 14px,
      48px 14px;
  }
  /* On the dark band the links are grey with a green underline, the arcade's own signal colour. */
  .wcgw-footer a {
    color: var(--color-neutral-400);
    text-decoration-color: var(--color-emerald-400);
  }
  .wcgw-footer a:hover {
    color: var(--color-neutral-200);
  }
  .wcgw-footer :focus-visible {
    outline-color: var(--color-emerald-400);
  }
</style>
