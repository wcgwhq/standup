---
/**
 * A small moulded character for each writing voice, in the receipt printer's camera and
 * light: seen from a little above, lit from the top, in the printer's orange, the lamps'
 * amber and the intake's graphite. Their colours are fixed, like the printer's, so they keep
 * their own light at every hour the sun dial paints. The paint (`#printer-top`, `#gear-top`
 * and their fronts) is defined once on the homepage, next to the printer's.
 *
 * Each is a small joke about its voice: a slice of plain toast with a straight face, a
 * rubber duck in a pirate hat and eye patch, the skull Gen Z types when something is funny,
 * a bar chart whose arrow has left the chart, a snare drum mid rimshot, and a comedy club's
 * microphone, stool and glass of water.
 */
interface Props {
  voice: string;
}
const { voice } = Astro.props;

const amberDark = 'color-mix(in srgb, var(--color-lamp-amber) 68%, var(--color-printer-dark))';
const bar = (x: number, y: number) => `
    <path fill="var(--color-gear-dark)" d="M${x + 9} ${y}l3-3V40l-3 3z"/>
    <path fill="var(--color-gear-light)" d="M${x} ${y}l3-3h9l-3 3z"/>
    <rect fill="url(#gear-front)" x="${x}" y="${y}" width="9" height="${43 - y}"/>`;

const objects: Record<string, string> = {
  plain: `
    <path fill="${amberDark}" d="M18 18.500c-4.500-.500-5.500-8 1.500-9.500 5-3.500 19-3.500 24 0 7 1.500 6 9 1.500 9.500V39a3 3 0 0 1-3 3H21a3 3 0 0 1-3-3z"/>
    <path fill="var(--color-lamp-amber)" d="M14 18.500C9.500 18 8.500 10.500 15.500 9c5-3.500 19-3.500 24 0 7 1.500 6 9 1.500 9.500V39a3 3 0 0 1-3 3H17a3 3 0 0 1-3-3z"/>
    <path fill="var(--color-gear-ink)" d="M17 20.500c-4-.800-4-7 1-8.500 4.500-3 14.500-3 19 0 5 1.500 5 7.700 1 8.500V37a2 2 0 0 1-2 2H19a2 2 0 0 1-2-2z"/>
    <circle fill="var(--color-gear-dark)" cx="23" cy="24.500" r="1.500"/>
    <circle fill="var(--color-gear-dark)" cx="32" cy="24.500" r="1.500"/>
    <path fill="none" stroke="var(--color-gear-dark)" stroke-width="1.600" stroke-linecap="round" d="M24 31h7"/>`,
  pirate: `
    <path fill="var(--color-lamp-amber)" d="M40 27l7-5.500-1.500 9z"/>
    <ellipse fill="${amberDark}" cx="29" cy="35" rx="15" ry="8.500"/>
    <ellipse fill="var(--color-lamp-amber)" cx="29" cy="33" rx="15" ry="8.500"/>
    <path fill="${amberDark}" d="M26 33q6.500-6 13 0q-6.500 5.500-13 0z"/>
    <circle fill="var(--color-lamp-amber)" cx="20" cy="21" r="9"/>
    <ellipse fill="#fff" opacity=".45" cx="23.500" cy="16.500" rx="2.500" ry="1.500"/>
    <path fill="url(#printer-top)" d="M12 20.500 4.500 22.500q-1 1.300.300 2.200L12 26z"/>
    <path fill="none" stroke="var(--color-gear-dark)" stroke-width="1.400" d="M11.500 16.500 28.500 18.500"/>
    <ellipse fill="var(--color-gear-dark)" cx="16.500" cy="19.500" rx="2.800" ry="3.200"/>
    <ellipse fill="var(--color-gear-dark)" cx="20" cy="14.500" rx="12.500" ry="2.800"/>
    <path fill="url(#gear-top)" d="M10.500 14q9.500-13.500 19 0q-9.500 3-19 0z"/>
    <circle fill="var(--color-gear-ink)" cx="20" cy="9.500" r="2"/>
    <rect fill="var(--color-gear-ink)" x="18.800" y="10.800" width="2.400" height="1.800" rx=".6"/>`,
  genz: `
    <g transform="rotate(-9 28 24)">
      <rect fill="var(--color-gear-muted)" x="21" y="27" width="17" height="11" rx="4"/>
      <circle fill="var(--color-gear-muted)" cx="29.500" cy="20" r="13.500"/>
      <rect fill="var(--color-gear-ink)" x="19.500" y="27" width="16" height="11" rx="4"/>
      <circle fill="var(--color-gear-ink)" cx="27.500" cy="20" r="13.500"/>
      <ellipse fill="#fff" opacity=".7" cx="22" cy="11.500" rx="4" ry="2.200" transform="rotate(-28 22 11.500)"/>
      <ellipse fill="var(--color-gear-dark)" cx="22" cy="21" rx="3.800" ry="4.600"/>
      <ellipse fill="var(--color-gear-dark)" cx="33" cy="21" rx="3.800" ry="4.600"/>
      <path fill="var(--color-gear-dark)" d="M27.500 26l-1.800 3.200h3.600z"/>
      <path fill="none" stroke="var(--color-gear-muted)" stroke-width="1.300" stroke-linecap="round" d="M23.500 33v4.500M27.500 33v4.500M31.500 33v4.500"/>
    </g>
    <path fill="url(#printer-top)" d="M46 5c.5 3.200 1.300 4 4.500 4.500-3.200.5-4 1.300-4.500 4.500-.5-3.200-1.300-4-4.500-4.500 3.200-.5 4-1.300 4.500-4.500z"/>
    <path fill="var(--color-lamp-amber)" d="M9 9c.3 1.800.700 2.200 2.500 2.500-1.800.300-2.200.700-2.500 2.500-.3-1.800-.700-2.200-2.500-2.500 1.800-.300 2.200-.700 2.500-2.500z"/>`,
  corporate: `${bar(8, 33)}${bar(21, 26)}${bar(34, 19)}
    <path fill="none" stroke="var(--color-printer-dark)" stroke-width="3.400" stroke-linecap="round" stroke-linejoin="round" d="M6 29.500 17 21.500l8 4.500L46 5.500M38.500 5h8v8"/>
    <path fill="none" stroke="var(--color-printer-light)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M6 28.500 17 20.500l8 4.500L46 4.500M38.500 4h8v8"/>`,
  oneliner: `
    <path fill="url(#printer-front)" d="M11 20v13c0 3.600 7.600 6.500 17 6.500s17-2.900 17-6.500V20z"/>
    <path fill="none" stroke="var(--color-printer-light)" stroke-width="1.300" opacity=".85" d="M16.500 26v11M28 27.500v12M39.500 26v11"/>
    <ellipse fill="var(--color-gear-ink)" stroke="var(--color-printer-light)" stroke-width="1.800" cx="28" cy="20" rx="17" ry="6.200"/>
    <g class="voice-sticks">
      <path fill="none" stroke="var(--color-lamp-amber)" stroke-width="2.600" stroke-linecap="round" d="M33 5 24.500 18.500M50 10 35.500 19.500"/>
    </g>
    <path fill="none" stroke="var(--color-printer)" stroke-width="1.500" stroke-linecap="round" d="M19 13.500l-2.500-2.500M22 11.500l-.800-3.300M16.500 17l-3.400-.600"/>`,
  observational: `
    <path fill="none" stroke="var(--color-gear-light)" stroke-width="2.200" stroke-linecap="round" d="M35 30 32.500 43M47 30l2.500 13M33.800 37.500h14.400"/>
    <ellipse fill="var(--color-gear-dark)" cx="41" cy="30.500" rx="9.500" ry="3"/>
    <ellipse fill="url(#gear-top)" cx="41" cy="29" rx="9.500" ry="3"/>
    <rect fill="var(--color-gear-ink)" x="38" y="19" width="6" height="10" rx="1.200"/>
    <rect fill="var(--color-gear-muted)" x="38" y="23.500" width="6" height="5.500" rx="1.200"/>
    <ellipse fill="url(#gear-front)" cx="16" cy="42.500" rx="8.500" ry="2.400"/>
    <ellipse fill="url(#gear-top)" cx="16" cy="41.500" rx="8.500" ry="2.400"/>
    <path fill="none" stroke="var(--color-gear-light)" stroke-width="2.200" stroke-linecap="round" d="M16 41V17"/>
    <g transform="rotate(24 16 15)">
      <rect fill="url(#gear-top)" x="11.500" y="2" width="9" height="15" rx="4.500"/>
      <path fill="none" stroke="var(--color-gear-dark)" stroke-width=".9" d="M11.800 6.500h8.400M11.500 9.500h9"/>
      <rect fill="url(#printer-top)" x="11.500" y="12" width="9" height="2.600"/>
    </g>`,
};
---

<svg class="voice-icon" viewBox="0 0 56 48" width="56" height="48" aria-hidden="true">
  <ellipse cx="28" cy="44.500" rx="17" ry="2.400" fill="var(--color-ink)" opacity="0.13"></ellipse>
  <Fragment set:html={objects[voice] ?? objects.plain} />
</svg>
