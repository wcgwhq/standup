---
/**
 * The sun dial: the bottom edge of the window is the horizon, a rail from one side to the
 * other, and over its middle stands the day's arc: a true arc, a segment of a circle, with
 * midnight at its left end, noon at the top and 11:59pm at its right end. A moulded sun rides a low arc over it by day and a moon by night, the part of
 * the day already spent burns orange along the rail, clouds stand by day and stars come
 * out at night. Dragging the sun (or the slider, for keys and screen readers), or pressing
 * anywhere on the rail, sets the page's time of day: the clock in the lede, which lede is
 * shown, and the colours of the whole page from night through dawn, day and dusk.
 * Left alone it follows the visitor's real clock. "Now" returns to it.
 * Only the sun and the rail take the pointer; the sky above the rail lets clicks and
 * scrolling through to the page. Without JavaScript the dial stays hidden and the page
 * keeps its system colours.
 */
interface Props {
  label: string;
  reset: string;
  now: string;
  hint: string;
  /** Names for 6am, noon and 6pm, under the three ticks. */
  hours: string[];
}
const { label, reset, now, hint, hours } = Astro.props;

// The night sky behind the whole page: the same stars on every build (a fixed seed), spread
// over the window. Every fifth one twinkles.
let seed = 20261111;
const random = () => (seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296;
const sky = Array.from({ length: 64 }, (_, index) => ({
  left: (random() * 100).toFixed(2),
  top: (random() * 100).toFixed(2),
  size: random() < 0.2 ? 3 : random() < 0.5 ? 2 : 1,
  twinkle: index % 5 === 0,
  delay: (random() * 4).toFixed(1),
}));
---

{/* Behind the page: sun rays that fan out from wherever the sun is, and a sky of stars at night. */}
<div id="sky-layer" class="sky-layer" aria-hidden="true" hidden>
  <div class="sky-glow"></div>
  <div class="sky-rays"></div>
  <div class="sky-stars">
    {sky.map((star) => (
      <i
        class:list={[star.twinkle && 'sky-twinkle']}
        style={`left:${star.left}%;top:${star.top}%;width:${star.size}px;height:${star.size}px;animation-delay:${star.delay}s`}
      />
    ))}
  </div>
</div>

{/* The frost behind the dial is its own element: inside the dial the blur would see nothing to blur. */}
<div id="sun-dial-frost" class="sun-dial-frost" aria-hidden="true" hidden></div>
<div id="sun-dial" class="sun-dial" hidden>
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <defs>
      <radialGradient id="sun-ball" cx="0.36" cy="0.3" r="0.8">
        <stop offset="0" style="stop-color: color-mix(in srgb, #fff 72%, var(--color-lamp-amber))"></stop>
        <stop offset="0.38" stop-color="var(--color-lamp-amber)"></stop>
        <stop offset="1" stop-color="var(--color-printer)"></stop>
      </radialGradient>
      <radialGradient id="moon-ball" cx="0.36" cy="0.3" r="0.85">
        <stop offset="0" stop-color="#fff"></stop>
        <stop offset="0.45" stop-color="var(--color-gear-ink)"></stop>
        <stop offset="1" stop-color="var(--color-gear-muted)"></stop>
      </radialGradient>
      <clipPath id="sun-dial-past">
        <rect id="sun-dial-past-rect" x="0" y="0" width="0" height="100"></rect>
      </clipPath>
    </defs>
  </svg>
  <div class="sun-dial-field">
    <svg class="sun-dial-arcs" viewBox="0 0 100 18" aria-hidden="true">
      <path
        class="sun-dial-wash"
        d="M0 18A78.444 78.444 0 0 1 100 18Z"
        clip-path="url(#sun-dial-past)"
      ></path>
      <path class="sun-dial-arc" d="M0 18A78.444 78.444 0 0 1 100 18"></path>
      <path
        class="sun-dial-trail"
        d="M0 18A78.444 78.444 0 0 1 100 18"
        clip-path="url(#sun-dial-past)"
      ></path>
    </svg>
    <div class="sun-dial-stars" aria-hidden="true">
      <i style="left:4%;top:30%"></i>
      <i style="left:11%;top:72%"></i>
      <i style="left:19%;top:18%"></i>
      <i style="left:27%;top:55%"></i>
      <i style="left:36%;top:80%"></i>
      <i style="left:45%;top:25%"></i>
      <i style="left:55%;top:62%"></i>
      <i style="left:63%;top:12%"></i>
      <i style="left:72%;top:48%"></i>
      <i style="left:80%;top:78%"></i>
      <i style="left:88%;top:22%"></i>
      <i style="left:95%;top:58%"></i>
    </div>
    <span class="sun-dial-cloud" style="left:27%;bottom:34%">
      <svg viewBox="0 0 44 22" aria-hidden="true">
        <ellipse cx="22" cy="17" rx="19" ry="4.5" fill="var(--color-gear-muted)"></ellipse>
        <path
          fill="var(--color-gear-ink)"
          d="M6 16a5.500 5.500 0 0 1 3-10 8 8 0 0 1 15-2.500A6.500 6.500 0 0 1 36 8a4.500 4.500 0 0 1 2 8.500z"
        ></path>
        <ellipse cx="17" cy="6" rx="4" ry="1.600" fill="#fff" opacity=".7"></ellipse>
      </svg>
    </span>
    <span class="sun-dial-cloud sun-dial-cloud-far" style="left:69%;bottom:52%">
      <svg viewBox="0 0 44 22" aria-hidden="true">
        <ellipse cx="22" cy="17" rx="19" ry="4.5" fill="var(--color-gear-muted)"></ellipse>
        <path
          fill="var(--color-gear-ink)"
          d="M6 16a5.500 5.500 0 0 1 3-10 8 8 0 0 1 15-2.500A6.500 6.500 0 0 1 36 8a4.500 4.500 0 0 1 2 8.500z"
        ></path>
        <ellipse cx="17" cy="6" rx="4" ry="1.600" fill="#fff" opacity=".7"></ellipse>
      </svg>
    </span>
    <div id="sun-dial-body" class="sun-dial-body">
      <svg class="sun-dial-shape" viewBox="0 0 48 48" aria-hidden="true">
        <g class="sun-dial-sun">
          <circle cx="24" cy="24" r="23" fill="var(--color-lamp-amber)" opacity="0.2"></circle>
          <circle cx="24" cy="24" r="17.500" fill="var(--color-lamp-amber)" opacity="0.28"></circle>
          <circle cx="24" cy="24" r="13.500" fill="url(#sun-ball)"></circle>
          <ellipse
            cx="19.500"
            cy="18"
            rx="4"
            ry="2.300"
            fill="#fff"
            opacity="0.75"
            transform="rotate(-30 19.500 18)"
          ></ellipse>
        </g>
        <g class="sun-dial-moon">
          <circle cx="24" cy="24" r="19" fill="var(--color-gear-ink)" opacity="0.12"></circle>
          <circle cx="24" cy="24" r="13" fill="url(#moon-ball)"></circle>
          <circle cx="28.500" cy="20" r="2.600" fill="var(--color-gear-muted)" opacity="0.7"></circle>
          <circle cx="21" cy="29" r="1.900" fill="var(--color-gear-muted)" opacity="0.7"></circle>
          <circle cx="29.500" cy="29.500" r="1.200" fill="var(--color-gear-muted)" opacity="0.7"></circle>
          <path
            d="M24 11a13 13 0 0 1 0 26 16 16 0 0 0 0-26z"
            fill="var(--color-gear-dark)"
            opacity="0.22"
          ></path>
        </g>
      </svg>
      <div class="sun-dial-tag">
        <output id="sun-dial-time" class="sun-dial-time" for="sun-dial-range"></output>
        <span class="sun-dial-hint">{hint}</span>
        <button
          id="sun-dial-reset"
          class="sun-dial-reset"
          type="button"
          aria-label={`${now}. ${reset}`}
          hidden
        >
          {now}
        </button>
      </div>
    </div>
  </div>
  <div id="sun-dial-rail" class="sun-dial-rail">
    <span class="sun-dial-burn"></span>
    <span class="sun-dial-tick" style="--at:0"></span>
    {hours.map((hour, index) => (
      <span class="sun-dial-tick" style={`--at:${(index + 1) / 4}`}>
        {hour}
      </span>
    ))}
    <span class="sun-dial-tick" style="--at:1"></span>
  </div>
  <input
    id="sun-dial-range"
    class="sun-dial-range"
    type="range"
    min="0"
    max="1435"
    step="5"
    aria-label={label}
  />
</div>

<style is:global>
  .sun-dial,
  .sun-dial-frost {
    /* The arc is a true arc: a segment of a circle, 100 wide and 18 high, centred over the rail.
       --w is its chord; everything along the day is placed between the two --pad margins. */
    --w: min(30rem, 100vw - 5.5rem);
    --pad: calc((100% - var(--w)) / 2);
    --slab: 0.5rem;
    --rail: calc(2rem + env(safe-area-inset-bottom));
    --arc: calc(var(--w) * 0.18);
    --ball: 3rem;
  }
  .sun-dial {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    height: calc(var(--rail) + var(--arc) + var(--ball) / 2 + 2rem);
    pointer-events: none;
    user-select: none;
    view-transition-name: sun-dial;
  }
  /* The strip is frosted, not solid: the page shows through it, softened, and its top edge fades out. */
  .sun-dial-frost {
    position: fixed;
    inset: auto 0 0;
    z-index: 39;
    height: calc(var(--rail) + var(--arc) + var(--ball) / 2 + 2rem);
    pointer-events: none;
    /* Solid under the rail, where the hours are printed; frosted above it. */
    background: linear-gradient(
      to top,
      var(--color-paper) calc(var(--rail) - var(--slab)),
      color-mix(in srgb, var(--color-paper) 60%, transparent) calc(var(--rail) - var(--slab))
    );
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    -webkit-mask-image: linear-gradient(to top, #000 calc(100% - 3rem), transparent);
    mask-image: linear-gradient(to top, #000 calc(100% - 3rem), transparent);
  }
  /* The sky behind the page. --sun-x and --sun-y are where the sun is in the window, and
     --rays is how strong its light is: strongest when it is low, gone at night. */
  .sky-layer {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .sky-glow,
  .sky-rays,
  .sky-stars {
    position: absolute;
    inset: 0;
  }
  .sky-glow {
    background: radial-gradient(
      circle 46vmax at var(--sun-x, 50%) var(--sun-y, 100%),
      color-mix(in srgb, var(--color-sun) 20%, transparent),
      transparent
    );
    opacity: calc(0.35 + var(--rays, 0) * 4);
  }
  :root[data-sky='night'] .sky-glow {
    background: radial-gradient(
      circle 38vmax at var(--sun-x, 50%) var(--sun-y, 100%),
      color-mix(in srgb, var(--color-ink) 9%, transparent),
      transparent
    );
    opacity: 1;
  }
  .sky-rays {
    background:
      repeating-conic-gradient(
        from 4deg at var(--sun-x, 50%) var(--sun-y, 100%),
        var(--color-sun) 0deg 2.5deg,
        transparent 2.5deg 13deg
      ),
      repeating-conic-gradient(
        from 0deg at var(--sun-x, 50%) var(--sun-y, 100%),
        var(--color-sun) 0deg 5deg,
        transparent 5deg 23deg
      );
    opacity: var(--rays, 0);
    -webkit-mask-image: radial-gradient(
      circle 80vmax at var(--sun-x, 50%) var(--sun-y, 100%),
      #000 4%,
      transparent 70%
    );
    mask-image: radial-gradient(
      circle 80vmax at var(--sun-x, 50%) var(--sun-y, 100%),
      #000 4%,
      transparent 70%
    );
  }
  .sky-stars i {
    position: absolute;
    border-radius: 50%;
    background: var(--color-ink);
    opacity: 0;
    transition: opacity 0.6s ease-out;
  }
  :root[data-sky='night'] .sky-stars i {
    opacity: 0.6;
  }
  :root[data-sky='night'] .sky-stars .sky-twinkle {
    animation: sky-twinkle 3.6s ease-in-out infinite alternate;
  }
  @keyframes sky-twinkle {
    from {
      opacity: 0.2;
    }
    to {
      opacity: 1;
    }
  }
  /* The last block of the page (.dial-clearance) ends above the dial, so nothing sits under it. */
  :root:has(.sun-dial:not([hidden])) .dial-clearance {
    padding-bottom: calc(12rem + env(safe-area-inset-bottom));
  }
  /* Keyboard focus and in-page links stop above the dial, never under it. */
  :root:has(.sun-dial:not([hidden])) {
    scroll-padding-bottom: calc(12rem + env(safe-area-inset-bottom));
  }
  .sun-dial-field {
    position: absolute;
    right: var(--pad);
    bottom: var(--rail);
    left: var(--pad);
    height: var(--arc);
  }
  .sun-dial-arcs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .sun-dial-arc,
  .sun-dial-trail {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 1 7;
    vector-effect: non-scaling-stroke;
  }
  /* The part of the day already behind you is drawn solid, in the sun's colour. */
  .sun-dial-trail {
    stroke: var(--color-sun);
    stroke-width: 2;
    stroke-dasharray: none;
  }
  .sun-dial-wash {
    fill: color-mix(in srgb, var(--color-sun) 14%, transparent);
  }
  .sun-dial[data-sky='night'] .sun-dial-wash {
    fill: color-mix(in srgb, var(--color-ink) 6%, transparent);
  }
  .sun-dial-stars i {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: var(--color-ink);
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }
  .sun-dial-stars i:nth-child(3n) {
    width: 3px;
    height: 3px;
  }
  .sun-dial[data-sky='night'] .sun-dial-stars i {
    opacity: 0.75;
  }
  .sun-dial-cloud {
    position: absolute;
    width: 2.75rem;
    translate: -50% 0;
    transition: opacity 0.4s ease-out;
  }
  .sun-dial-cloud-far {
    width: 2rem;
    opacity: 0.8;
  }
  .sun-dial-cloud svg {
    display: block;
    width: 100%;
  }
  .sun-dial[data-sky='night'] .sun-dial-cloud {
    opacity: 0;
  }
  /* The sun: where it sits along the horizon is the time, and it climbs the arc toward noon. */
  .sun-dial-body {
    position: absolute;
    bottom: calc(var(--h, 1) * 100%);
    left: calc(var(--t, 0.5) * 100%);
    width: var(--ball);
    height: var(--ball);
    translate: -50% 50%;
    cursor: grab;
    pointer-events: auto;
    touch-action: none;
  }
  .sun-dial.is-dragging .sun-dial-body {
    cursor: grabbing;
  }
  .sun-dial-shape {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    border-radius: 50%;
    transition: scale 150ms ease-out;
  }
  .sun-dial-body:hover .sun-dial-shape,
  .sun-dial.is-dragging .sun-dial-shape {
    scale: 1.12;
  }
  .sun-dial[data-sky='day'] .sun-dial-moon,
  .sun-dial[data-sky='night'] .sun-dial-sun {
    display: none;
  }
  .sun-dial:has(.sun-dial-range:focus-visible) .sun-dial-shape {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* The time travels with the sun. Near the edges of the window it slides inward (--shift). */
  .sun-dial-tag {
    position: absolute;
    bottom: calc(100% - 0.15rem);
    left: 50%;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    background: var(--color-paper);
    font-size: 0.75rem;
    white-space: nowrap;
    translate: calc(-50% + var(--shift, 0px)) 0;
    /* The label takes no clicks, so whatever is behind it still does. Its button does. */
    pointer-events: none;
  }
  .sun-dial-time {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .sun-dial-hint {
    color: var(--color-muted);
  }
  .sun-dial[data-used] .sun-dial-hint {
    display: none;
  }
  .sun-dial-reset {
    position: relative;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    text-decoration: underline var(--color-accent);
    text-underline-offset: 0.18em;
    cursor: pointer;
    pointer-events: auto;
  }
  /* A 44px target around a small word. */
  .sun-dial-reset::after {
    position: absolute;
    inset: -0.8rem -0.6rem;
    content: '';
  }
  .sun-dial-reset:hover {
    text-decoration-thickness: 2px;
  }
  /* The rail: a graphite slab from edge to edge, lit from above like the printer. Press it anywhere. */
  .sun-dial-rail {
    position: absolute;
    inset: auto 0 0;
    height: var(--rail);
    background: linear-gradient(
        to bottom,
        var(--color-gear-light) 0 2px,
        var(--color-gear) 2px,
        var(--color-gear-dark) var(--slab),
        transparent var(--slab)
      )
      no-repeat;
    cursor: pointer;
    pointer-events: auto;
    touch-action: pan-y;
  }
  /* The day so far, burnt orange along the slab. */
  .sun-dial-burn {
    position: absolute;
    top: 0;
    left: var(--pad);
    width: calc(var(--t, 0.5) * (100% - 2 * var(--pad)));
    height: var(--slab);
    background: linear-gradient(
      to bottom,
      var(--color-printer-light) 0 2px,
      var(--color-printer) 2px,
      var(--color-printer-dark)
    );
  }
  .sun-dial-tick {
    position: absolute;
    top: var(--slab);
    left: calc(var(--pad) + var(--at) * (100% - 2 * var(--pad)));
    padding-top: 0.45rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    translate: -50% 0;
  }
  .sun-dial-tick::before {
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 0.3rem;
    background: var(--color-muted);
    content: '';
  }
  /* The real control: a range input over the sky, invisible but focusable. */
  .sun-dial-range {
    position: absolute;
    right: var(--pad);
    bottom: var(--rail);
    left: var(--pad);
    width: calc(100% - 2 * var(--pad));
    height: var(--arc);
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  @media (max-width: 39.99rem) {
    .sun-dial,
    .sun-dial-frost {
      --ball: 2.75rem;
    }
    .sun-dial-hint {
      display: none;
    }
    .sun-dial-cloud {
      width: 2rem;
    }
    .sun-dial-cloud-far {
      width: 1.5rem;
    }
    :root:has(.sun-dial:not([hidden])) .dial-clearance {
      padding-bottom: calc(9.5rem + env(safe-area-inset-bottom));
    }
    :root:has(.sun-dial:not([hidden])) {
      scroll-padding-bottom: calc(9.5rem + env(safe-area-inset-bottom));
    }
  }
  @media (min-width: 64rem) {
    .sun-dial,
    .sun-dial-frost {
      --ball: 3.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sun-dial-shape,
    .sun-dial-stars i,
    .sun-dial-cloud,
    .sky-stars i {
      transition: none;
    }
    :root[data-sky='night'] .sky-stars .sky-twinkle {
      animation: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const dial = document.getElementById('sun-dial');
    const range = document.getElementById('sun-dial-range');
    const body = document.getElementById('sun-dial-body');
    const past = document.getElementById('sun-dial-past-rect');
    const out = document.getElementById('sun-dial-time');
    const reset = document.getElementById('sun-dial-reset');
    const field = dial.querySelector('.sun-dial-field');
    const rail = document.getElementById('sun-dial-rail');
    const tag = dial.querySelector('.sun-dial-tag');

    // Page ground through the day: [minute, [r, g, b]]. Everything else derives from it.
    // Night is blue-black, the hour before sunrise is plum, sunrise is rose, the day is
    // paper, the hour before sunset is gold, then rose, plum and back to blue.
    const SKY = [
      [0, [18, 19, 24]],
      [300, [22, 23, 34]],
      [375, [62, 44, 60]],
      [420, [242, 216, 204]],
      [480, [245, 230, 210]],
      [600, [241, 243, 242]],
      [960, [241, 243, 242]],
      [1080, [243, 224, 194]],
      [1140, [238, 204, 180]],
      [1200, [58, 40, 62]],
      [1275, [26, 28, 46]],
      [1440, [18, 19, 24]],
    ];
    const mix = (a, b, t) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
    const css = (c) => `rgb(${c[0]} ${c[1]} ${c[2]})`;
    const lum = (c) => {
      const f = (v) => ((v /= 255) <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
      return 0.2126 * f(c[0]) + 0.7152 * f(c[1]) + 0.0722 * f(c[2]);
    };
    const ratio = (a, b) => {
      const x = lum(a) + 0.05;
      const y = lum(b) + 0.05;
      return x > y ? x / y : y / x;
    };
    const DAY = [241, 243, 242];
    const NIGHT = [18, 19, 24];
    const sky = (m) => {
      for (let i = 1; i < SKY.length; i++) {
        if (m <= SKY[i][0]) {
          const [m0, c0] = SKY[i - 1];
          const [m1, c1] = SKY[i];
          return mix(c0, c1, (m - m0) / (m1 - m0));
        }
      }
      return SKY[0][1];
    };

    const paint = (m) => {
      const raw = sky(m);
      // Ink flips where black and white text are equally readable on the ground.
      const light = lum(raw) > 0.18;
      const ink = light ? [26, 26, 24] : [236, 235, 230];
      // Dusk and dawn pass through greys no ink reads on. Pull the ground toward
      // day or night until body text reaches 7:1, then set muted text at 4.5:1 or better.
      let paper = raw;
      for (let t = 0.05; ratio(ink, paper) < 7 && t <= 1; t += 0.05) paper = mix(raw, light ? DAY : NIGHT, t);
      let soft = 0.31;
      while (soft > 0 && ratio(mix(ink, paper, soft), paper) < 4.5) soft -= 0.02;
      // Underlines and the focus ring need 3:1; near dusk the blue leans toward the ink to keep it.
      const blue = light ? [21, 93, 252] : [81, 162, 255];
      let accent = blue;
      for (let t = 0.1; ratio(accent, paper) < 3 && t <= 1; t += 0.1) accent = mix(blue, ink, t);
      const set = (name, c) => root.style.setProperty(name, css(c));
      set('--color-paper', paper);
      set('--color-ink', ink);
      set('--color-muted', mix(ink, paper, Math.max(0, soft)));
      set('--color-rule', mix(paper, ink, 0.15));
      set('--color-accent', accent);
      set('--color-accent-soft', mix(paper, accent, 0.18));
      set('--color-sun', light ? [217, 138, 0] : [255, 192, 77]);
      root.style.colorScheme = light ? 'light' : 'dark';
      return light;
    };

    const clock = (m) => {
      const h = Math.floor(m / 60);
      return `${h % 12 || 12}:${String(m % 60).padStart(2, '0')}${h < 12 ? 'am' : 'pm'}`;
    };
    const part = (h) =>
      h >= 5 && h < 9
        ? 'morning'
        : h >= 9 && h < 12
          ? 'midmorning'
          : h >= 12 && h < 17
            ? 'afternoon'
            : h >= 17 && h < 21
              ? 'evening'
              : 'night';
    // The lede is three nodes: the words before the time, the time, and the rest.
    // Within one part of the day only the time changes. Across parts the rest is
    // reprinted: a short band of scrambled letters runs through it, new text behind
    // it and old text ahead, the way a receipt printer overwrites a line.
    const GLYPHS = 'abcdefghijklmnopqrstuvwxyz0123456789';
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let slots = null;
    let shown = null;
    let timer = 0;
    const reprint = (el, to) => {
      clearTimeout(timer);
      const from = el.textContent;
      const length = Math.max(from.length, to.length);
      const start = performance.now();
      const frame = () => {
        const t = Math.min(1, (performance.now() - start) / 500);
        if (t === 1) return void (el.textContent = to);
        const cut = Math.floor(t * length);
        const band = (to.slice(cut, cut + 8) || from.slice(cut, cut + 8)).replace(
          /\S/g,
          () => GLYPHS[Math.floor(Math.random() * GLYPHS.length)],
        );
        el.textContent = to.slice(0, cut) + band + from.slice(cut + 8);
        timer = setTimeout(frame, 30);
      };
      frame();
    };
    // Ledes differ in length. The paragraph glides to its new height while the
    // reprint runs, so the page below it slides and does not jump.
    let settle = 0;
    const glide = (el, from, to) => {
      clearTimeout(settle);
      el.style.cssText = `height:${from}px;overflow:clip`;
      el.offsetHeight;
      el.style.cssText = `height:${to}px;overflow:clip;transition:height 500ms ease`;
      settle = setTimeout(() => (el.style.cssText = ''), 520);
    };
    const lede = (m) => {
      const el = document.getElementById('lede');
      if (!el || !el.dataset.ledes) return;
      if (!slots) {
        slots = [document.createTextNode(''), document.createElement('span'), document.createElement('span')];
        el.replaceChildren(...slots);
      }
      const key = part(Math.floor(m / 60));
      const [before, after = ''] = JSON.parse(el.dataset.ledes)[key].split('{time}');
      slots[0].data = before;
      slots[1].textContent = clock(m);
      if (key === shown) return;
      if (shown === null || still.matches) slots[2].textContent = after;
      else {
        const from = el.getBoundingClientRect().height;
        const old = slots[2].textContent;
        el.style.cssText = '';
        slots[2].textContent = after;
        const to = el.getBoundingClientRect().height;
        slots[2].textContent = old;
        glide(el, from, to);
        reprint(slots[2], after);
      }
      shown = key;
    };

    const nowMinutes = () => {
      const d = new Date();
      return d.getHours() * 60 + d.getMinutes();
    };
    // null = follow the real clock. A number = the visitor moved the sun.
    let chosen = null;
    try {
      const saved = sessionStorage.getItem('sun-dial');
      if (saved !== null) chosen = Number(saved);
    } catch {}
    const minutes = () => (chosen === null ? nowMinutes() : chosen);

    // The minute on the dial right now. It trails `minutes()` while the dial travels.
    let showing = null;
    const draw = (m) => {
      showing = m;
      // The whole day lies along the arc: midnight at its left end, noon at the top, 11:59pm
      // at its right end. The arc is a segment of a circle 100 wide and 18 high (radius R),
      // the same one the SVG draws, so the sun sits exactly on the line.
      const t = m / 1440;
      const R = 78.444;
      dial.style.setProperty('--t', t.toFixed(4));
      dial.style.setProperty('--h', ((Math.sqrt(R * R - (100 * t - 50) ** 2) - (R - 18)) / 18).toFixed(4));
      past.setAttribute('width', (t * 100).toFixed(2));
      range.value = m;
      range.setAttribute('aria-valuetext', clock(m));
      out.textContent = clock(m);
      // The clock in the lede runs with the dial, so the page tells one time.
      if (slots) slots[1].textContent = clock(m);
      // The moon and the stars come out when the page itself turns dark, not at a fixed hour.
      const light = paint(m);
      dial.dataset.sky = root.dataset.sky = light ? 'day' : 'night';
      // The time label stays inside the window when the sun is near an edge.
      const f = field.getBoundingClientRect();
      const half = tag.offsetWidth / 2;
      const centre = f.left + t * f.width;
      const shift = Math.max(8 + half - centre, Math.min(0, innerWidth - 8 - half - centre));
      tag.style.setProperty('--shift', `${shift.toFixed(1)}px`);
      // The sky behind the page turns on the sun: its rays fan out from where it is, and are
      // strongest when it is low, at dawn and dusk.
      const height = Number(dial.style.getPropertyValue('--h'));
      root.style.setProperty('--sun-x', `${centre.toFixed(0)}px`);
      root.style.setProperty('--sun-y', `${(f.bottom - height * f.height).toFixed(0)}px`);
      root.style.setProperty('--rays', light ? (0.045 + 0.06 * (1 - height)).toFixed(3) : '0');
    };
    // A jump is travelled, not cut: the sun runs along the arc and the colours follow.
    let travelling = 0;
    const travel = (from, to, ms) => {
      clearTimeout(travelling);
      const start = performance.now();
      const step = () => {
        const t = Math.min(1, (performance.now() - start) / ms);
        // Ease in and out, so it leaves and arrives gently.
        const e = t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2;
        draw(Math.round(from + (to - from) * e));
        travelling = t < 1 ? setTimeout(step, 16) : 0;
      };
      step();
    };
    const show = (animate) => {
      const m = minutes();
      reset.hidden = chosen === null;
      lede(m);
      if (animate && showing !== null && showing !== m && !still.matches) return travel(showing, m, 700);
      clearTimeout(travelling);
      travelling = 0;
      draw(m);
    };
    const choose = (m, animate) => {
      chosen = m === null ? null : Math.min(1435, Math.max(0, Math.round(m / 5) * 5));
      try {
        if (chosen === null) sessionStorage.removeItem('sun-dial');
        else sessionStorage.setItem('sun-dial', chosen);
      } catch {}
      show(animate);
    };

    // The sun sits under the finger: where you drag it along the horizon is the time.
    // Clicking the rail anywhere sends it there.
    let dragging = false;
    const fromPointer = (e, animate) => {
      const r = field.getBoundingClientRect();
      choose(((e.clientX - r.left) / r.width) * 1440, animate);
    };
    // Once the visitor has moved the dial, the line saying it can be dragged goes away for the visit.
    const used = () => {
      dial.dataset.used = '';
      try {
        sessionStorage.setItem('sun-dial-used', '1');
      } catch {}
    };
    try {
      if (sessionStorage.getItem('sun-dial-used') || chosen !== null) dial.dataset.used = '';
    } catch {}
    body.addEventListener('pointerdown', (e) => {
      if (e.target.closest('button')) return;
      used();
      dragging = true;
      body.setPointerCapture(e.pointerId);
      dial.classList.add('is-dragging');
    });
    body.addEventListener('pointermove', (e) => {
      if (dragging) fromPointer(e, false);
    });
    const release = () => {
      dragging = false;
      dial.classList.remove('is-dragging');
    };
    body.addEventListener('pointerup', release);
    body.addEventListener('pointercancel', release);
    // A click, not a press: a scroll that starts on the rail must not move the sun.
    rail.addEventListener('click', (e) => {
      used();
      fromPointer(e, true);
    });
    range.addEventListener('input', () => {
      used();
      choose(Number(range.value), false);
    });
    reset.addEventListener('click', () => choose(null, true));

    dial.hidden = false;
    document.getElementById('sky-layer').hidden = false;
    document.getElementById('sun-dial-frost').hidden = false;
    let first = false;
    try {
      first = !sessionStorage.getItem('sun-dial-swept');
      sessionStorage.setItem('sun-dial-swept', '1');
    } catch {}
    // On the first page of a visit the day runs from 8am to now (from midnight, before
    // 8am). The page opens at the starting hour, waits half a second, then the
    // sun, the colours and the clock in the lede move together. Touching the dial stops it.
    reset.hidden = chosen === null;
    let opening = 0;
    if (first && chosen === null && !still.matches) {
      const from = nowMinutes() < 480 ? 0 : 480;
      draw(from);
      opening = setTimeout(() => {
        opening = 0;
        if (chosen === null && !dragging) travel(from, nowMinutes(), 2000);
      }, 500);
    } else draw(minutes());
    // The lede is further down the page than this script; fill it once it exists.
    document.addEventListener('DOMContentLoaded', () => {
      lede(minutes());
      if (opening && slots) slots[1].textContent = clock(showing);
    });
    // After the first paint, colour changes ease (global.css: .sky-moves).
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add('sky-moves')));
    const tick = () => {
      if (chosen === null && !travelling && !opening && !dragging) show(true);
      setTimeout(tick, 60000 - (Date.now() % 60000) + 50);
    };
    setTimeout(tick, 60000 - (Date.now() % 60000) + 50);
  })();
</script>
