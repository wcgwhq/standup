---
/**
 * The sun dial: half an ellipse over a horizon, fixed at the bottom centre.
 * The arc is the whole day: midnight at the left end, noon at the top, 11:59pm at
 * the right end. A sun rides it by day and a moon by night. Dragging it (or the slider, for keys
 * and screen readers) sets the page's time of day: the clock in the lede, which
 * lede is shown, and the colours of the whole page from night through dawn, day and dusk.
 * Left alone it follows the visitor's real clock. "Now" returns to it.
 * Without JavaScript the dial stays hidden and the page keeps its system colours.
 * From 1280px it leaves the bottom edge for the empty margin right of the column, at
 * about one and a half times the size, with the hours named under the horizon and, until
 * the visitor first moves it, a line saying it can be dragged.
 */
interface Props {
  label: string;
  reset: string;
  now: string;
  hint: string;
  /** Names for 6am, noon and 6pm, under the three ticks. */
  hours: string[];
}
const { label, reset, now, hint, hours } = Astro.props;
---

<div id="sun-dial" class="sun-dial" hidden>
  <svg viewBox="0 0 200 76" aria-hidden="true">
    <defs>
      <clipPath id="sun-dial-sky">
        <rect x="0" y="0" width="200" height="68"></rect>
      </clipPath>
      <clipPath id="sun-dial-past">
        <rect id="sun-dial-past-rect" x="0" y="0" width="0" height="68"></rect>
      </clipPath>
      <mask id="sun-dial-crescent">
        <rect x="-10" y="-10" width="20" height="20" fill="#fff"></rect>
        <circle cx="4" cy="-3" r="6.5" fill="#000"></circle>
      </mask>
    </defs>
    <path class="sun-dial-wash" d="M14 68 A86 54 0 0 1 186 68Z" clip-path="url(#sun-dial-past)"></path>
    <path class="sun-dial-arc" d="M14 68 A86 54 0 0 1 186 68"></path>
    <path class="sun-dial-trail" d="M14 68 A86 54 0 0 1 186 68" clip-path="url(#sun-dial-past)"></path>
    <path class="sun-dial-ticks" d="M57 68v4M100 68v6M143 68v4"></path>
    <g clip-path="url(#sun-dial-sky)">
      <g id="sun-dial-body">
        <g class="sun-dial-shape">
          <circle class="sun-dial-halo" r="13"></circle>
          <circle class="sun-dial-sun" r="8"></circle>
          <circle class="sun-dial-moon" r="7.5" mask="url(#sun-dial-crescent)"></circle>
        </g>
      </g>
    </g>
    <path class="sun-dial-horizon" d="M4 68H196"></path>
    <g class="sun-dial-hours">
      {hours.map((hour, index) => (
        <text x={57 + index * 43} y="84">
          {hour}
        </text>
      ))}
    </g>
  </svg>
  <input
    id="sun-dial-range"
    class="sun-dial-range"
    type="range"
    min="0"
    max="1435"
    step="5"
    aria-label={label}
  />
  <div class="sun-dial-row">
    <output id="sun-dial-time" class="sun-dial-time" for="sun-dial-range"></output>
    <button id="sun-dial-reset" class="sun-dial-reset" type="button" aria-label={reset} hidden>
      {now}
    </button>
  </div>
  <p class="sun-dial-hint">{hint}</p>
</div>

<style is:global>
  .sun-dial {
    --dial: 11rem;
    position: fixed;
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
    left: 50%;
    translate: -50% 0;
    z-index: 40;
    width: var(--dial);
    box-sizing: content-box;
    padding: 0.5rem 0.75rem 0;
    border: 1px solid var(--color-rule);
    border-radius: calc(var(--dial) * 0.59) calc(var(--dial) * 0.59) 1rem 1rem / calc(var(--dial) * 0.43)
      calc(var(--dial) * 0.43) 1rem 1rem;
    background: var(--color-paper);
    touch-action: none;
    user-select: none;
    view-transition-name: sun-dial;
  }
  /* The last block of the page (.dial-clearance) ends above the dial, so nothing sits under it. */
  @media (max-width: 79.99rem) {
    :root:has(.sun-dial:not([hidden])) .dial-clearance {
      padding-bottom: calc(10.5rem + env(safe-area-inset-bottom));
    }
  }
  .sun-dial svg {
    display: block;
    width: 100%;
    overflow: visible;
    cursor: grab;
  }
  .sun-dial.is-dragging svg {
    cursor: grabbing;
  }
  @media (pointer: coarse) {
    .sun-dial {
      --dial: 12.5rem;
    }
  }
  .sun-dial-arc,
  .sun-dial-trail,
  .sun-dial-ticks,
  .sun-dial-horizon {
    fill: none;
    stroke: var(--color-rule);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .sun-dial-arc {
    stroke-dasharray: 1 5;
  }
  /* The part of the day (or night) already behind you is drawn solid. */
  .sun-dial-trail,
  .sun-dial-horizon {
    stroke: var(--color-ink);
  }
  .sun-dial-sun,
  .sun-dial-halo {
    fill: var(--color-sun);
  }
  .sun-dial-halo {
    opacity: 0.22;
  }
  /* The day so far, washed in the sun's colour. */
  .sun-dial-wash {
    fill: color-mix(in srgb, var(--color-sun) 16%, transparent);
  }
  .sun-dial[data-sky='night'] .sun-dial-wash {
    fill: color-mix(in srgb, var(--color-ink) 7%, transparent);
  }
  .sun-dial-hours,
  .sun-dial-hint {
    display: none;
  }
  .sun-dial-hours text {
    fill: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 7.5px;
    text-anchor: middle;
  }
  .sun-dial-moon {
    fill: var(--color-ink);
  }
  .sun-dial[data-sky='day'] .sun-dial-moon,
  .sun-dial[data-sky='night'] .sun-dial-sun,
  .sun-dial[data-sky='night'] .sun-dial-halo {
    display: none;
  }
  /* Picked up, the sun grows a little. */
  .sun-dial-shape {
    transform-box: fill-box;
    transform-origin: center;
    transition: scale 150ms ease-out;
  }
  .sun-dial.is-dragging .sun-dial-shape {
    scale: 1.25;
  }
  /* The real control: a range input over the arc, invisible but focusable. */
  .sun-dial-range {
    position: absolute;
    inset: 0.5rem 0.75rem auto;
    width: var(--dial);
    height: calc(var(--dial) * 0.36);
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .sun-dial:has(.sun-dial-range:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .sun-dial-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 2rem;
  }
  .sun-dial-time {
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .sun-dial-reset {
    grid-column: 3;
    justify-self: start;
    align-self: stretch;
    min-width: 2.75rem;
    padding: 0 0.5rem;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font-size: 0.8125rem;
    text-decoration: underline var(--color-accent);
    text-underline-offset: 0.18em;
    cursor: pointer;
  }
  .sun-dial-reset:hover {
    text-decoration-thickness: 2px;
  }
  @media (pointer: coarse) {
    .sun-dial-row {
      height: 2.75rem;
    }
  }
  /* A wide screen has an empty margin right of the column. The dial moves up into it,
     beside the hero, and grows: it is the page's instrument there, not a tab on its edge. */
  @media (min-width: 80rem) {
    .sun-dial {
      --dial: 17rem;
      top: 6.5rem;
      bottom: auto;
      left: calc(75vw + 9rem);
      padding: 1rem 1.25rem 0.5rem;
    }
    .sun-dial svg {
      margin-bottom: 1.25rem;
    }
    .sun-dial-range {
      inset: 1rem 1.25rem auto;
    }
    .sun-dial-hours {
      display: block;
    }
    .sun-dial-row {
      height: 2.75rem;
    }
    .sun-dial-time {
      font-size: 1.125rem;
    }
    .sun-dial-hint {
      display: block;
      margin: 0 0 0.5rem;
      color: var(--color-muted);
      font-size: 0.75rem;
      text-align: center;
    }
    .sun-dial[data-used] .sun-dial-hint {
      visibility: hidden;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const dial = document.getElementById('sun-dial');
    const range = document.getElementById('sun-dial-range');
    const body = document.getElementById('sun-dial-body');
    const past = document.getElementById('sun-dial-past-rect');
    const out = document.getElementById('sun-dial-time');
    const reset = document.getElementById('sun-dial-reset');
    const svg = dial.querySelector('svg');

    // Page ground through the day: [minute, [r, g, b]]. Everything else derives from it.
    // Night is blue-black, the hour before sunrise is plum, sunrise is rose, the day is
    // paper, the hour before sunset is gold, then rose, plum and back to blue.
    const SKY = [
      [0, [18, 19, 24]],
      [300, [22, 23, 34]],
      [375, [62, 44, 60]],
      [420, [242, 216, 204]],
      [480, [245, 230, 210]],
      [600, [241, 243, 242]],
      [960, [241, 243, 242]],
      [1080, [243, 224, 194]],
      [1140, [238, 204, 180]],
      [1200, [58, 40, 62]],
      [1275, [26, 28, 46]],
      [1440, [18, 19, 24]],
    ];
    const mix = (a, b, t) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
    const css = (c) => `rgb(${c[0]} ${c[1]} ${c[2]})`;
    const lum = (c) => {
      const f = (v) => ((v /= 255) <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
      return 0.2126 * f(c[0]) + 0.7152 * f(c[1]) + 0.0722 * f(c[2]);
    };
    const ratio = (a, b) => {
      const x = lum(a) + 0.05;
      const y = lum(b) + 0.05;
      return x > y ? x / y : y / x;
    };
    const DAY = [241, 243, 242];
    const NIGHT = [18, 19, 24];
    const sky = (m) => {
      for (let i = 1; i < SKY.length; i++) {
        if (m <= SKY[i][0]) {
          const [m0, c0] = SKY[i - 1];
          const [m1, c1] = SKY[i];
          return mix(c0, c1, (m - m0) / (m1 - m0));
        }
      }
      return SKY[0][1];
    };

    const paint = (m) => {
      const raw = sky(m);
      // Ink flips where black and white text are equally readable on the ground.
      const light = lum(raw) > 0.18;
      const ink = light ? [26, 26, 24] : [236, 235, 230];
      // Dusk and dawn pass through greys no ink reads on. Pull the ground toward
      // day or night until body text reaches 7:1, then set muted text at 4.5:1 or better.
      let paper = raw;
      for (let t = 0.05; ratio(ink, paper) < 7 && t <= 1; t += 0.05) paper = mix(raw, light ? DAY : NIGHT, t);
      let soft = 0.31;
      while (soft > 0 && ratio(mix(ink, paper, soft), paper) < 4.5) soft -= 0.02;
      // Underlines and the focus ring need 3:1; near dusk the blue leans toward the ink to keep it.
      const blue = light ? [21, 93, 252] : [81, 162, 255];
      let accent = blue;
      for (let t = 0.1; ratio(accent, paper) < 3 && t <= 1; t += 0.1) accent = mix(blue, ink, t);
      const set = (name, c) => root.style.setProperty(name, css(c));
      set('--color-paper', paper);
      set('--color-ink', ink);
      set('--color-muted', mix(ink, paper, Math.max(0, soft)));
      set('--color-rule', mix(paper, ink, 0.15));
      set('--color-accent', accent);
      set('--color-accent-soft', mix(paper, accent, 0.18));
      set('--color-sun', light ? [217, 138, 0] : [255, 192, 77]);
      root.style.colorScheme = light ? 'light' : 'dark';
    };

    const clock = (m) => {
      const h = Math.floor(m / 60);
      return `${h % 12 || 12}:${String(m % 60).padStart(2, '0')}${h < 12 ? 'am' : 'pm'}`;
    };
    const part = (h) =>
      h >= 5 && h < 9
        ? 'morning'
        : h >= 9 && h < 12
          ? 'midmorning'
          : h >= 12 && h < 17
            ? 'afternoon'
            : h >= 17 && h < 21
              ? 'evening'
              : 'night';
    // The lede is three nodes: the words before the time, the time, and the rest.
    // Within one part of the day only the time changes. Across parts the rest is
    // reprinted: a short band of scrambled letters runs through it, new text behind
    // it and old text ahead, the way a receipt printer overwrites a line.
    const GLYPHS = 'abcdefghijklmnopqrstuvwxyz0123456789';
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let slots = null;
    let shown = null;
    let timer = 0;
    const reprint = (el, to) => {
      clearTimeout(timer);
      const from = el.textContent;
      const length = Math.max(from.length, to.length);
      const start = performance.now();
      const frame = () => {
        const t = Math.min(1, (performance.now() - start) / 500);
        if (t === 1) return void (el.textContent = to);
        const cut = Math.floor(t * length);
        const band = (to.slice(cut, cut + 8) || from.slice(cut, cut + 8)).replace(
          /\S/g,
          () => GLYPHS[Math.floor(Math.random() * GLYPHS.length)],
        );
        el.textContent = to.slice(0, cut) + band + from.slice(cut + 8);
        timer = setTimeout(frame, 30);
      };
      frame();
    };
    // Ledes differ in length. The paragraph glides to its new height while the
    // reprint runs, so the page below it slides and does not jump.
    let settle = 0;
    const glide = (el, from, to) => {
      clearTimeout(settle);
      el.style.cssText = `height:${from}px;overflow:clip`;
      el.offsetHeight;
      el.style.cssText = `height:${to}px;overflow:clip;transition:height 500ms ease`;
      settle = setTimeout(() => (el.style.cssText = ''), 520);
    };
    const lede = (m) => {
      const el = document.getElementById('lede');
      if (!el || !el.dataset.ledes) return;
      if (!slots) {
        slots = [document.createTextNode(''), document.createElement('span'), document.createElement('span')];
        el.replaceChildren(...slots);
      }
      const key = part(Math.floor(m / 60));
      const [before, after = ''] = JSON.parse(el.dataset.ledes)[key].split('{time}');
      slots[0].data = before;
      slots[1].textContent = clock(m);
      if (key === shown) return;
      if (shown === null || still.matches) slots[2].textContent = after;
      else {
        const from = el.getBoundingClientRect().height;
        const old = slots[2].textContent;
        el.style.cssText = '';
        slots[2].textContent = after;
        const to = el.getBoundingClientRect().height;
        slots[2].textContent = old;
        glide(el, from, to);
        reprint(slots[2], after);
      }
      shown = key;
    };

    const nowMinutes = () => {
      const d = new Date();
      return d.getHours() * 60 + d.getMinutes();
    };
    // null = follow the real clock. A number = the visitor moved the sun.
    let chosen = null;
    try {
      const saved = sessionStorage.getItem('sun-dial');
      if (saved !== null) chosen = Number(saved);
    } catch {}
    const minutes = () => (chosen === null ? nowMinutes() : chosen);

    // The whole day is on the arc: midnight at the left end (x = 14), noon at the
    // top, 11:59pm at the right end (x = 186). The sun is up from 6am to 6pm; the
    // moon has the rest.
    const LEFT = 14;
    const SPAN = 172;
    const bodyX = (m) => LEFT + (SPAN * m) / 1440;
    // The minute on the dial right now. It trails `minutes()` while the dial travels.
    let showing = null;
    const draw = (m) => {
      showing = m;
      const x = bodyX(m);
      const y = 68 - 54 * Math.sqrt(Math.max(0, 1 - ((x - 100) / 86) ** 2));
      body.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)})`);
      past.setAttribute('width', x.toFixed(1));
      dial.dataset.sky = m >= 360 && m < 1080 ? 'day' : 'night';
      range.value = m;
      range.setAttribute('aria-valuetext', clock(m));
      out.textContent = clock(m);
      // The clock in the lede runs with the dial, so the page tells one time.
      if (slots) slots[1].textContent = clock(m);
      paint(m);
    };
    // A jump is travelled, not cut: the sun runs along the arc and the colours follow.
    let travelling = 0;
    const travel = (from, to, ms) => {
      clearTimeout(travelling);
      const start = performance.now();
      const step = () => {
        const t = Math.min(1, (performance.now() - start) / ms);
        // Ease in and out, so it leaves and arrives gently.
        const e = t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2;
        draw(Math.round(from + (to - from) * e));
        travelling = t < 1 ? setTimeout(step, 16) : 0;
      };
      step();
    };
    const show = (animate) => {
      const m = minutes();
      reset.hidden = chosen === null;
      lede(m);
      if (animate && showing !== null && showing !== m && !still.matches) return travel(showing, m, 700);
      clearTimeout(travelling);
      travelling = 0;
      draw(m);
    };
    const choose = (m, animate) => {
      chosen = m === null ? null : Math.min(1435, Math.max(0, Math.round(m / 5) * 5));
      try {
        if (chosen === null) sessionStorage.removeItem('sun-dial');
        else sessionStorage.setItem('sun-dial', chosen);
      } catch {}
      show(animate);
    };

    // The sun sits under the finger: where you press or drag along the arc is the time.
    let dragging = false;
    const fromPointer = (e, animate) => {
      const r = svg.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width) * 200;
      choose(((x - LEFT) / SPAN) * 1440, animate);
    };
    // Once the visitor has moved the dial, the line saying it can be dragged goes away for the visit.
    const used = () => {
      dial.dataset.used = '';
      try {
        sessionStorage.setItem('sun-dial-used', '1');
      } catch {}
    };
    try {
      if (sessionStorage.getItem('sun-dial-used') || chosen !== null) dial.dataset.used = '';
    } catch {}
    svg.addEventListener('pointerdown', (e) => {
      used();
      const r = svg.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width) * 200;
      dragging = true;
      svg.setPointerCapture(e.pointerId);
      dial.classList.add('is-dragging');
      // Pressing the sun picks it up. Pressing elsewhere on the arc sends it there.
      if (Math.abs(x - bodyX(showing ?? minutes())) > 12) fromPointer(e, true);
    });
    svg.addEventListener('pointermove', (e) => {
      if (dragging) fromPointer(e, false);
    });
    const release = () => {
      dragging = false;
      dial.classList.remove('is-dragging');
    };
    svg.addEventListener('pointerup', release);
    svg.addEventListener('pointercancel', release);
    range.addEventListener('input', () => {
      used();
      choose(Number(range.value), false);
    });
    reset.addEventListener('click', () => choose(null, true));

    dial.hidden = false;
    let first = false;
    try {
      first = !sessionStorage.getItem('sun-dial-swept');
      sessionStorage.setItem('sun-dial-swept', '1');
    } catch {}
    // On the first page of a visit the day runs from 8am to now (from midnight, before
    // 8am). The page opens at the starting hour, waits half a second, then the
    // sun, the colours and the clock in the lede move together. Touching the dial stops it.
    reset.hidden = chosen === null;
    let opening = 0;
    if (first && chosen === null && !still.matches) {
      const from = nowMinutes() < 480 ? 0 : 480;
      draw(from);
      opening = setTimeout(() => {
        opening = 0;
        if (chosen === null && !dragging) travel(from, nowMinutes(), 2000);
      }, 500);
    } else draw(minutes());
    // The lede is further down the page than this script; fill it once it exists.
    document.addEventListener('DOMContentLoaded', () => {
      lede(minutes());
      if (opening && slots) slots[1].textContent = clock(showing);
    });
    // After the first paint, colour changes ease (global.css: .sky-moves).
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add('sky-moves')));
    const tick = () => {
      if (chosen === null && !travelling && !opening && !dragging) show(true);
      setTimeout(tick, 60000 - (Date.now() % 60000) + 50);
    };
    setTimeout(tick, 60000 - (Date.now() % 60000) + 50);
  })();
</script>
